---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";

/*
  PHOTOS ONLY
  The cards now show a photo instead of a video. Replace each `image` with the real photo.

  CAROUSEL
  Desktop shows 4 cards, tablet 2, phone 1. The arrows, dots, swipe and the left/right
  keys move it one card at a time and it loops.

  SEE MORE
  Descriptions longer than 3 lines are cut off and get a "See more" button automatically.
  Clicking it opens the full text inside a small scrollable box (scroll with the mouse
  wheel or by touch) and the page scrolls gently so the whole text is in view.
  Short descriptions show nothing extra.
*/
const SEE_MORE = "See more";

const agents = [
{
    name: "Angela R.",
    role: "Intake Specialist & Legal Assistant",
    headline: "Your experience is your advantage",
    description: "Hi, I'm Angela R. I currently work as an Intake Specialist and Legal Assistant for a personal injury law firm. My responsibilities include conducting intakes with potential new clients, following up on cases for client or attorney determination, requesting and obtaining medical records and billing statements, requesting police reports, and providing administrative support to the legal team. I also assist paralegals with different tasks to help keep cases moving forward. Before becoming a Legal VA, I worked in the BPO industry for 10 years. Although I had years of experience in customer service, entering the legal field was a completely different experience for me. I had zero experience in the legal field. I was intimidated by all the legal terminologies and worried about making mistakes, especially because I didn't have any background in law. Everything was new to me, and I wasn't sure if I could keep up. It was challenging to step into an industry that I knew very little about, but I decided to give myself a chance. My turning point came when my client started giving me positive feedback about my work. That gave me the confidence that I was doing something right. Eventually, I also realized that the job wasn't as difficult as I initially thought. I just needed to be willing to learn, understand the processes, and be consistent. As I became more familiar with my responsibilities, I gained more confidence in my ability to handle the work. Looking back, I can say that becoming a Legal VA has made a huge difference in my life. If it weren't for my VA career, I wouldn't have been able to afford renovating our house, purchasing a car, and providing a much more comfortable life for my family. Compared to my years working in the BPO industry, our quality of life has improved significantly. I'm grateful because this career has given me opportunities that I never thought would be possible when I was just starting out. It's not just about the professional growth but also the opportunities it has given me to improve my family's life. If there's one thing I would tell someone who is thinking about becoming a Legal VA, it's that everybody starts at zero. You just have to have the courage to believe that you can do it. Believe in yourself, be proactive, and never be afraid to ask questions. However, before asking for help, make sure you've done your research and tried to figure things out on your own first. The legal field is fast-paced, and you have to be mindful of the attorneys' and paralegals' time. Don't make them spend time answering questions that you could have easily researched yourself. Most importantly, don't let your lack of experience stop you from trying. You don't need to know everything when you start. You just need to be willing to learn and put in the work.",
    image: "/assets/images/t001-nova/Angela.jpeg",
},
  

  {
    name: "Angeline Valero",
    role: "Legal Intake Supervisor",
    headline: "It's never too late to start again",
    description: "Hi, my name is Angeline Valero. I worked as a Legal Intake Supervisor, where I handled client intake and supported the team in managing incoming inquiries and potential clients. Before working in the legal industry, I worked in the BPO industry for several years, where I developed my communication, problem-solving, and customer service skills. Although I already had experience dealing with different types of customers, transitioning into the legal industry was a different experience because it required me to learn new processes, terminology, and how to handle sensitive information. Honestly, my biggest concern was whether I would be able to understand the legal terminology and the processes involved. I was worried about making mistakes, especially because legal cases involve important information and people's personal situations. I questioned whether I was qualified enough and whether I could keep up with the expectations of working in a law firm. But I realized that I didn't need to know everything from the beginning. I just needed to be willing to learn, follow the processes, ask questions, and be attentive to details. My turning point was when I started becoming familiar with the processes and realized that many of the skills I already had from customer service were actually very valuable in the legal industry. Being able to communicate with people, listen carefully, ask the right questions, document information accurately, and handle difficult conversations were skills I already possessed. As I gained more experience and responsibility, I became more confident in myself. Eventually, I was trusted not only to handle intake responsibilities but also to supervise and support other intake specialists. That's when I realized that I was capable of growing and building a career in the legal field. Working in the legal industry gave me an opportunity to grow professionally and develop skills that I didn't have before. It helped me become more confident, responsible, organized, and comfortable working in a professional environment. It also gave me a different perspective on my career. I realized that my customer service background wasn't something I needed to leave behind—it was something I could build on and use to enter a specialized industry. My experience as a Legal Intake Supervisor allowed me to take on more responsibilities, work with a team, and develop leadership skills. It showed me that there are opportunities to grow when you're willing to learn and step outside your comfort zone. If there's one thing I would tell someone who is nervous about taking the first step, it's not to let fear stop them from trying. You don't have to be an expert or have a legal background before you start. Everyone begins somewhere. If you have experience in customer service, communication, administration, or even just a willingness to learn, those skills can be valuable in the legal industry. Don't be afraid of making mistakes as long as you're willing to learn from them, ask questions, and improve. Sometimes, the opportunity you're afraid to take is the one that can open doors you never imagined. Believe in yourself, be patient with your progress, and give yourself a chance. You might surprise yourself with what you're capable of.",
    image: "/assets/images/t001-nova/Angeline.jpeg",
},


  {
    name: "Anne Reyes",
    role: "Legal Assistant",
    headline: "Just Give It a Try",
    description: "Dear Future Legal VA, I'm Anne, and I'm currently working as a Legal Assistant for a personal injury law firm based in New York. My main responsibility is handling client intakes. I take inbound calls from potential clients, gather their personal information, ask about the circumstances surrounding their accidents, and document the details for the attorneys to review. In many cases, I'm the first point of contact for someone reaching out to the firm, so I also make sure they feel heard and comfortable sharing their experiences. Before transitioning into the legal VA industry, I spent almost nine years in the BPO industry. I worked as a Quality Assurance Specialist and an Operations Supervisor, where I developed my communication, leadership, problem-solving, and customer service skills. Looking back, I realized that a lot of those skills were transferable to my current role. Of course, transitioning into the legal field came with its own challenges. My biggest worries were not being familiar with legal terminology and making mistakes, especially when it came to providing accurate information to the attorneys. I understood that my role played an important part in the intake process, and the accuracy of the information I gathered could affect how a potential case was evaluated. So, I was initially worried about whether I could handle that responsibility. But during training, as I started observing how things were done, I realized that I could actually do it. I would pull up previous cases, read through how they were handled, and listen to recorded intake calls. I learned a lot through observation and practice. That's when I started gaining confidence and realized that I didn't have to know everything right away. I just had to be willing to learn. Working as a Legal VA has definitely changed my life in many ways. It has given me a better work-life balance and allowed me to spend more time with my family. I also have the flexibility to travel while continuing to work, which is something I really appreciate. Financially, it has given me more capacity to support myself and pursue other goals. In fact, I was able to continue my education and pursue my Master's degree while working. It's given me opportunities that I might not have had otherwise. For anyone who is nervous about taking that first step, I would say: Just give it a try. It's completely normal to feel intimidated, especially when you're entering an industry that's unfamiliar to you. You don't have to have everything figured out before you start. Be willing to learn, be patient with yourself, and give yourself a chance. There's no harm in trying. At the end of the day, I think it's better to try and see where it takes you than to look back and regret not trying at all. Sincerely, Anne Reyes",
    image: "/assets/images/t001-nova/Anne.jpeg",
},



  {
    name: "Edmar Conroy",
    role: "Intake Specialist, Civil Litigation Law Firm",
    headline: "Every big opportunity comes with a big risk",
    description: "My name is Edmar Conroy, and I work in Intake for a law firm specializing in civil litigation involving sexual abuse. My primary responsibility is making outbound calls to potential clients (victims) who reach us through our advertisements or website. I conduct preliminary screenings to determine whether they may have a viable case before forwarding their information to the attorneys for final review. Most of my communication is through phone calls, but I also handle emails and SMS. Before becoming a Legal VA, I worked as a Customer Service Representative in the BPO industry. Moving into the legal field was a completely new experience for me, especially since my background was in customer service rather than law. My biggest concerns were my lack of formal legal education and having no prior work experience in the legal field. I wasn't sure how I would handle the responsibilities or whether I would be able to adjust to an industry I knew very little about. To be honest, I didn't necessarily think I could do it. I was simply in a situation where I desperately wanted to leave the BPO industry, so I had to make it work. I knew I had to take the opportunity and give it my best, even without knowing exactly what to expect. Looking back, I can say that working as a Legal VA has dramatically changed my life and my family's life. I earn significantly more, get to spend more time with my family every day, and have gained valuable knowledge, skills, and experience that I never would have imagined acquiring before. It has given me opportunities that have made a real difference not only in my career but also in my personal life. If there's one thing I would tell someone who is nervous about taking the first step, it's that every big opportunity comes with a big risk. Don't wait for things to feel easy before taking that first step. Great things are almost never handed to anyone easily. You only truly fail when you stop trying.",
    image: "/assets/images/t001-nova/Edmar.jpeg",
},



{
    name: "James L.",
    role: "Legal Virtual Assistant",
    headline: "You don't have to be perfect to get started",
    description: "Hi! My name is James L. I currently work as a Legal Virtual Assistant in a personal injury law firm. My role involves supporting the firm's daily operations and helping ensure that tasks and processes are handled efficiently. My experience in legal billing has also helped me understand the importance of accuracy, organization, and attention to detail when handling legal matters. Before becoming a Legal VA, I worked as a Billing Specialist in a personal injury law firm. Prior to that, I was a Supervisor in a Business Process Outsourcing (BPO) company. My experience in the BPO industry helped me develop leadership, communication, problem-solving, and organizational skills. When I transitioned into the legal industry, I was able to carry those skills with me and apply them to my new role. What worried me the most was having to learn so many new things. Everything was unfamiliar, especially the processes and procedures involved in performing tasks as a Legal VA. I knew I had to learn everything from the basics, including how to properly handle different tasks and understand legal terminology. However, my previous work experiences taught me to be resourceful and never stop learning. I learned that it's okay not to know everything right away, as long as you're willing to find answers and improve along the way. Once I became more familiar with the role, I started developing a routine that worked for me. I learned how to organize my daily activities, create task lists, and prioritize responsibilities based on their urgency and importance. I also gradually became familiar with legal terminology and the different processes involved in handling a case from start to finish. That was when I started gaining confidence. I realized that with proper organization, consistency, and continuous learning, I could actually do this job. Becoming a Legal VA has made a significant difference in my life. First, the income is considerably better compared to what I was earning in the local BPO industry. It has given me better financial opportunities. Second, I now enjoy a better work-life balance, which is something I truly appreciate. Lastly, I've grown both professionally and personally. I've learned new skills, gained knowledge, and developed habits that I can apply not only to my work but also to my everyday life. Overall, becoming a Legal VA has opened doors to better opportunities and allowed me to grow in ways I didn't initially expect. My advice is simple: Be confident, be willing to learn, and don't be afraid to fail. You don't have to know everything before getting started. There will always be new things to learn, challenges to overcome, and mistakes along the way. If you fail, learn from it. Don't let those mistakes discourage you. Instead, use them as opportunities to become better. Most importantly, never stop trying to improve yourself. Always strive to become a better version of yourself than you were yesterday. Remember, you don't have to be perfect to get started. You just have to be willing to learn, adapt, and keep moving forward.",
    image: "/assets/images/t001-nova/James.jpeg",
},

{
    name: "Jeric Sanchez",
    role: "Case Assistant",
    headline: "Fake It Till You Make It",
    description: "Dear Future Legal VA, Hi! My name is Jeric Sanchez, and I currently work as a Case Assistant for a personal injury law firm. My responsibilities include handling record retrieval, subrogation, auto insurance claims, balance verification, and other case-related tasks. Before becoming a Legal VA, I was working in the BPO industry. Moving into the legal field was something completely new to me, and honestly, everything was scary. Starting a new job in an industry where I had no experience made me feel doubtful and uncertain. There were so many things I didn't know, and I wasn't sure if I could handle everything that came with the role. But what kept me going was simple: poverty, money, the opportunity to gain new knowledge, and the hope of having a better life. Those were my motivations to take the chance and try something new. Looking back, working as a Legal VA has helped me in ways that matter most to me. I am now able to support my family's needs and still have something for my hobbies. Being able to provide for my family while also enjoying the things I love is something I'm grateful for. If there's one thing I would tell someone who's nervous about taking the first step, it's something one of my friends told me when I started: 'Fake it till you make it.' You just need the willingness to learn new things and the urge to become better than your previous self. You don't have to know everything from the beginning. What matters is that you're willing to learn, improve, and take on new challenges. We all start somewhere. Don't let the fact that you have no experience stop you from trying. Give yourself the chance to learn something new and become a better version of yourself. Sincerely, Jeric Sanchez",
    image: "/assets/images/t001-nova/Jeric.jpeg",
},

{
    name: "Marphin Alanza",
    role: "Legal Assistant",
    headline: "Every Expert Was Once a Beginner",
    description: "Dear Future Legal VA, My name is Marphin Alanza. I work for a law firm that focuses on toxic exposure, mass tort, and industrial contamination cases. I currently serve as a Legal Assistant, where my responsibilities include handling inbound and outbound client calls, assisting attorneys and paralegals with case management, communicating with clients via email, and reviewing medical records to identify qualifying injuries and relevant case information. Before becoming a Legal Virtual Assistant, I worked in the BPO industry, where I gained experience as a Technical Support Representative, Customer Service Representative, and Sales Representative. Before entering the legal field, my biggest concern was making preventable administrative errors that could impact case management or client service. I understood that the work required attention to detail and accuracy, and I wanted to make sure I could handle my responsibilities properly. The moment I realized I could succeed in this field was when I trusted my ability to learn and adapt. I knew that with dedication, continuous learning, and experience, I would eventually master the skills required for the role. I realized that I didn't have to know everything from the beginning. I just needed to be willing to learn and keep improving. Working as a Legal Virtual Assistant has had a significant positive impact on both my career and personal life. It has provided better financial opportunities, allowing me to save and invest, purchase a home, and provide a better quality of life for my family. Having these opportunities has made a meaningful difference in my life and has given me more opportunities to build a better future for the people I care about. To anyone who is hesitant about taking the first step, I would say: Take a leap of faith. Believe in your ability to learn and grow. Every expert was once a beginner, and with commitment and perseverance, you can achieve more than you think is possible. Don't let being new to something stop you from trying. Give yourself the opportunity to learn, gain experience, and discover what you are capable of achieving. Sincerely, Marphin Alanza",
    image: "/assets/images/t001-nova/Marphin.jpeg",
},  


{
    name: "Mary Rose Alanza",
    role: "Legal Assistant",
    headline: "Believe in Yourself",
    description: "Dear Future Legal VA, My name is Mary Rose Alanza, and I currently work as a Legal Assistant for a law firm specializing in toxic exposure, mass tort, and industrial contamination cases. My tasks include handling inbound and outbound calls, assisting attorneys and paralegals, communicating with clients through email, and reading medical records to identify qualifying injuries. Before becoming a Legal VA, I was working in the BPO industry as a Chat Support Representative, Customer Service Representative, and Sales Representative. When I first started working in the legal field, one of the things I worried about most was whether I could fulfill my role as a Legal Assistant. I wasn't sure if I could meet the expectations and handle all the responsibilities that came with the position. But eventually, I believed I could succeed as a Legal Assistant because of my strong communication skills, attention to detail, patience, and willingness to learn. My experience in handling clients, reviewing medical records, and managing case-related tasks has strengthened my confidence and my ability to grow in this field. Working as a Legal Virtual Assistant has positively impacted my life in many ways. It has allowed me to balance my career while caring for my newborn and has provided me with greater financial stability. Through this opportunity, I have been able to save for my children's future, purchase a home, and provide a better quality of life for my family. If there's one thing I would tell someone who is nervous about taking the first step, it would be to believe in themselves and take that first step, even if it feels scary. You don't have to know everything right away. What matters is your willingness to learn, grow, and step outside your comfort zone. Every opportunity starts with a little courage, and taking that chance could change your life for the better, just like it did for me. Believe in yourself, be willing to learn, and don't be afraid to take that first step. You never know how much an opportunity can change your life. Sincerely, Mary Rose Alanza",
    image: "/assets/images/t001-nova/Mary.jpeg",
},


{
    name: "Ryan Christian Lorion",
    role: "Intake Specialist",
    headline: "Keep Moving Forward",
    description: "Dear Future Legal VA, Hi! My name is Ryan Christian Lorion, and I currently work as an Intake Specialist for a personal injury law firm. My day-to-day responsibilities include handling inbound calls from prospective and current clients, as well as making outbound calls to prospective clients who have sent their inquiries through email or text messages. I also streamline information behind the scenes and make sure our lawyers are properly briefed and informed about each prospective client's situation before they interact with them. But before making the leap into the legal VA industry, I spent a full year working as a Customer Service Representative at a BPO call center. It was a fast-paced, high-volume environment filled with back-to-back calls, strict metrics, and constantly dealing with frustrated customers. The work was exhausting but memorable. Eventually, I knew I wanted something different, something out of the ordinary, and I was ready to venture into something new. Luckily, I was already a law student when I started working in the legal field. However, I realized that imposter syndrome was still something I had to deal with. I wasn't particularly worried about basic legal concepts, but what concerned me was the gap between applying what I learned in law school and dealing with real-world legal practice, especially when working with a different jurisdiction's procedures and unfamiliar case management software. In hindsight, the stakes felt more personal. In law school, a mistake might cost you points in a recitation or an exam. But in a real law firm, mismanaging a client intake, missing a filing deadline, or mishandling sensitive information could genuinely affect someone's case. That was something I took seriously. My 'I can actually do this' moment happened during my second week. I received a call from a client who was distressed and anxious about seeking legal representation. He had been involved in a workplace accident, but because he didn't have valid working documents and was an immigrant working in the US, he wasn't confident about whether he should seek representation. My customer service representative instincts kicked in. I assured him that we would represent his case to the best of our ability. I listened actively and intently, kept my tone warm and steady, gathered every detail accurately, and passed along a clean, well-organized summary to the paralegal. After the interaction, I received a simple 'Thank you for listening.' It might seem like a mundane thing, but that interaction changed his life, and we eventually secured representation for him. That was when I realized that I didn't need to be a lawyer to help people. There are other ways to make a difference, as long as you're reliable, empathetic, and organized. Stepping into the Legal VA world completely changed the trajectory of my life. Financially, my income increased significantly compared to when I was working as a Customer Service Representative, giving me breathing room I hadn't felt in years. More than the pay, though, it gave me my life back. Working remotely without a grueling daily commute means I actually have energy at the end of the day. I also feel genuinely respected as a professional rather than just another number on a call queue. So, if you're in my shoes, feeling anxious and experiencing the mental and physical exhaustion that comes with constant pressure, know that you have to take that first step to make your life better, whether it's sooner or later. If you can handle tough calls, stay composed under pressure, and navigate the rigors of studying the law, you are more than capable of mastering real-world legal workflows. You don't have to have every single detail figured out before you start. You just have to trust your preparation and your willingness to learn. And finally, take to heart that iconic reminder from Meet the Robinsons: 'Keep moving forward.' Every small step, every new tool learned, and every client helped builds your confidence. Take a deep breath, bet on yourself, and hit apply. Sincerely, Ryan Christian Lorion",
    image: "/assets/images/t001-nova/Lorion.jpeg",
},



];
---

<Section id="video-testimonials" tone="page" class="py-16 md:py-24 bg-white overflow-hidden">
  <Container class="w-full max-w-[72rem] mx-auto px-[clamp(1.25rem,5vw,3rem)]">

    <!-- Header -->
    <div class="mb-10 md:mb-14 grid gap-5 md:grid-cols-[1fr_auto] md:items-end md:gap-16">
      <div>
        <p class="flex items-center gap-3 text-sm font-medium text-[#FF8A00]">
          <span class="h-px w-8 bg-[#FF8A00]"></span>
          Agent stories
        </p>
        <h2 class="mt-4 max-w-3xl text-[clamp(2.1rem,4.2vw,3.5rem)] leading-[1.05] font-bold tracking-tight text-[#12213F]">
          Hear it from our agents
        </h2>
      </div>
      <p class="max-w-sm text-[#5A6478] text-base md:text-lg leading-relaxed">
        Real career journeys, in their own words.
      </p>
    </div>

    <!-- Carousel -->
    <div class="vt-carousel" data-vt-carousel>
      <div class="vt-viewport" data-vt-viewport>
        <ul class="vt-track" data-vt-track>
          {agents.map((agent) => (
            <li class="vt-card" data-vt-card>
              <div class="vt-media">
                <img src={agent.image} alt={agent.name} loading="lazy" draggable="false" />
              </div>

              <div class="vt-body">
                <p class="vt-name">{agent.name}</p>
                <p class="vt-role">{agent.role}</p>

                <div class="vt-rule" aria-hidden="true"></div>

                <h3 class="vt-headline">{agent.headline}</h3>

                <div class="vt-text">
                  <p class="vt-desc" data-vt-desc tabindex="-1">{agent.description}</p>
                  <button type="button" class="vt-more" data-vt-more aria-expanded="false" hidden>
                    {SEE_MORE}
                  </button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Carousel controls -->
      <div class="vt-controls">
        <button type="button" class="vt-arrow" data-vt-prev aria-label="Previous story">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg>
        </button>
        <div class="vt-dots" data-vt-dots role="group" aria-label="Choose story"></div>
        <button type="button" class="vt-arrow" data-vt-next aria-label="Next story">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </Container>
</Section>

<style>
  /* ---------- Carousel ---------- */
  .vt-carousel {
    position: relative;
  }

  .vt-viewport {
    overflow: hidden;
    padding: 1.5rem 1rem 2rem;
    margin: -1.5rem -1rem 0;
    touch-action: pan-y;
  }

  .vt-track {
    --vt-view: 1;
    --vt-gap: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: var(--vt-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 600ms cubic-bezier(0.22, 0.8, 0.24, 1);
    will-change: transform;
  }
  @media (min-width: 640px) {
    .vt-track {
      --vt-view: 2;
      --vt-gap: 1.5rem;
    }
  }
  @media (min-width: 1100px) {
    .vt-track {
      --vt-view: 4;
      --vt-gap: 1.75rem;
    }
  }

  .vt-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .vt-arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid #e4e8f0;
    border-radius: 999px;
    background: #fff;
    color: #12213f;
    box-shadow: 0 1px 2px rgba(18, 33, 63, 0.06), 0 10px 24px -8px rgba(18, 33, 63, 0.22);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 200ms ease;
  }
  .vt-arrow:hover {
    background: #12213f;
    border-color: #12213f;
    color: #fff;
    transform: translateY(-2px);
  }
  .vt-arrow:focus-visible,
  .vt-dot:focus-visible {
    outline: 3px solid #ff8a00;
    outline-offset: 3px;
  }

  .vt-dots {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .vt-dot {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #cfd6e4;
    cursor: pointer;
    transition: width 300ms ease, background-color 300ms ease;
  }
  .vt-dot[aria-current="true"] {
    width: 2rem;
    background: #ff8a00;
  }

  /* ---------- Card ---------- */
  .vt-card {
    flex: 0 0 calc((100% - (var(--vt-view) - 1) * var(--vt-gap)) / var(--vt-view));
    min-width: 0;
  }

  .vt-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #e6eaf2;
    box-shadow:
      0 2px 4px rgba(18, 33, 63, 0.06),
      0 18px 36px -16px rgba(18, 33, 63, 0.28);
  }
  .vt-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
    transition: transform 900ms cubic-bezier(0.22, 0.8, 0.24, 1);
  }
  .vt-card:hover .vt-media img {
    transform: scale(1.03);
  }

  /* ---------- Text ---------- */
  .vt-body {
    padding-top: 1.1rem;
  }

  .vt-name {
    color: #12213f;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .vt-role {
    margin-top: 0.25rem;
    color: #5a6478;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .vt-rule {
    height: 1px;
    margin: 1rem 0;
    background: #e4e8f0;
  }

  .vt-headline {
    color: #12213f;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .vt-text {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.45rem;
    margin-top: 0.5rem;
  }

  .vt-desc {
    color: #5a6478;
    font-size: 0.88rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    outline: none;
  }

  /* Opened: the full text sits in a small box you can scroll, so the card
     never becomes huge and the page layout stays the same. */
  .vt-desc.is-open {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    max-height: 9.5rem;
    overflow-y: auto;
    overscroll-behavior: contain; /* scrolling the text doesn't scroll the page */
    padding-right: 0.6rem;
    scrollbar-width: thin;
    scrollbar-color: #ff8a00 #eef1f6;
  }
  .vt-desc.is-open::-webkit-scrollbar {
    width: 6px;
  }
  .vt-desc.is-open::-webkit-scrollbar-track {
    background: #eef1f6;
    border-radius: 999px;
  }
  .vt-desc.is-open::-webkit-scrollbar-thumb {
    background: #ff8a00;
    border-radius: 999px;
  }

  .vt-more {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    color: #12213f;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #ff8a00;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .vt-more[hidden] {
    display: none;
  }
  .vt-more:hover {
    color: #ff8a00;
  }
  .vt-more:focus-visible {
    outline: 2px solid #ff8a00;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-media img,
    .vt-track,
    .vt-arrow,
    .vt-dot {
      transition: none;
    }
    .vt-arrow:hover { transform: none; }
    .vt-card:hover .vt-media img { transform: none; }
  }
</style>

<script>
  const SEE_MORE = "See more";
  const SEE_LESS = "See less";

  const root = document.querySelector<HTMLElement>("#video-testimonials");
  const carousel = root?.querySelector<HTMLElement>("[data-vt-carousel]");

  if (root && carousel) {
    const viewport = carousel.querySelector<HTMLElement>("[data-vt-viewport]")!;
    const track = carousel.querySelector<HTMLElement>("[data-vt-track]")!;
    const prevButton = carousel.querySelector<HTMLButtonElement>("[data-vt-prev]");
    const nextButton = carousel.querySelector<HTMLButtonElement>("[data-vt-next]");
    const dotsWrap = carousel.querySelector<HTMLElement>("[data-vt-dots]");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    /* ---------- Looping: a second copy of the cards follows the first ---------- */
    const originals = Array.from(track.children) as HTMLElement[];
    const total = originals.length;
    originals.forEach((card, i) => (card.dataset.orig = String(i)));
    originals.forEach((card) => track.appendChild(card.cloneNode(true)));

    /* ---------- See more / See less ---------- */
    const descs = Array.from(track.querySelectorAll<HTMLElement>("[data-vt-desc]"));

    // Show the button only when the text is actually cut off
    const measure = () => {
      descs.forEach((desc) => {
        const button = desc.parentElement?.querySelector<HTMLButtonElement>("[data-vt-more]");
        if (!button) return;
        const open = desc.classList.contains("is-open");
        button.hidden = !(open || desc.scrollHeight > desc.clientHeight + 1);
      });
    };

    const collapse = (desc: HTMLElement) => {
      const button = desc.parentElement?.querySelector<HTMLButtonElement>("[data-vt-more]");
      desc.classList.remove("is-open");
      desc.scrollTop = 0;
      if (button) {
        button.textContent = SEE_MORE;
        button.setAttribute("aria-expanded", "false");
      }
    };

    track.querySelectorAll<HTMLButtonElement>("[data-vt-more]").forEach((button) => {
      button.addEventListener("click", () => {
        const desc = button.parentElement?.querySelector<HTMLElement>("[data-vt-desc]");
        if (!desc) return;

        const open = desc.classList.toggle("is-open");
        button.textContent = open ? SEE_LESS : SEE_MORE;
        button.setAttribute("aria-expanded", String(open));

        if (open) {
          desc.scrollTop = 0;
          // Gently scroll the page so the opened text and its button are fully visible.
          // The page stays where it is, nothing is navigated away from.
          requestAnimationFrame(() => {
            button.scrollIntoView({
              behavior: reduceMotion.matches ? "auto" : "smooth",
              block: "nearest",
            });
          });
        } else {
          desc.scrollTop = 0;
        }
      });
    });

    document.fonts?.ready.then(measure);
    measure();

    /* ---------- Carousel ---------- */
    const wideMq = window.matchMedia("(min-width: 1100px)");
    const mediumMq = window.matchMedia("(min-width: 640px)");
    // Must match the CSS breakpoints on .vt-track
    const perView = () => (wideMq.matches ? 4 : mediumMq.matches ? 2 : 1);

    let dots: HTMLButtonElement[] = [];
    let busy = false;

    const cardsNow = () => Array.from(track.children) as HTMLElement[];
    const firstOrig = () => Number((track.firstElementChild as HTMLElement).dataset.orig);
    const stepPx = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (track.firstElementChild as HTMLElement).offsetWidth + gap;
    };

    const setX = (px: number, animate: boolean) => {
      track.style.transition = animate ? "" : "none";
      track.style.transform = `translate3d(${px}px, 0, 0)`;
    };

    // Cards outside the view can't be tabbed to or read by screen readers
    const sync = () => {
      const view = perView();
      cardsNow().forEach((card, i) => {
        const visible = i < view;
        card.toggleAttribute("inert", !visible);
        card.setAttribute("aria-hidden", visible ? "false" : "true");
      });
      const first = firstOrig();
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === first)));
    };

    const afterSlide = (done: () => void) => {
      if (reduceMotion.matches) {
        done();
        return;
      }
      let finished = false;
      const run = () => {
        if (finished) return;
        finished = true;
        track.removeEventListener("transitionend", onEnd);
        done();
      };
      const onEnd = (e: TransitionEvent) => {
        if (e.target === track && e.propertyName === "transform") run();
      };
      track.addEventListener("transitionend", onEnd);
      setTimeout(run, 800); // safety net
    };

    // n > 0 slides forward by n cards, n < 0 slides back
    const move = (n: number) => {
      if (busy || n === 0) return;
      // Close any opened descriptions before sliding
      descs.forEach((d) => d.classList.contains("is-open") && collapse(d));
      measure();
      busy = true;
      const step = stepPx();

      if (n > 0) {
        void track.offsetWidth;
        setX(-n * step, true);
        afterSlide(() => {
          for (let k = 0; k < n; k++) track.appendChild(track.firstElementChild as HTMLElement);
          setX(0, false);
          sync();
          busy = false;
        });
      } else {
        const m = -n;
        for (let k = 0; k < m; k++) track.insertBefore(track.lastElementChild as HTMLElement, track.firstElementChild);
        setX(-m * step, false);
        void track.offsetWidth;
        setX(0, true);
        afterSlide(() => {
          sync();
          busy = false;
        });
      }
    };

    const goToOriginal = (target: number) => {
      const forward = (target - firstOrig() + total) % total;
      if (forward === 0) return;
      move(forward <= total / 2 ? forward : -(total - forward));
    };

    const buildDots = () => {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = "";
      dots = [];
      for (let i = 0; i < total; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "vt-dot";
        dot.setAttribute("aria-label", `Go to story ${i + 1}`);
        dot.addEventListener("click", () => goToOriginal(i));
        dotsWrap.appendChild(dot);
        dots.push(dot);
      }
    };

    prevButton?.addEventListener("click", () => move(-1));
    nextButton?.addEventListener("click", () => move(1));

    // Arrow keys
    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") move(-1);
      if (e.key === "ArrowRight") move(1);
    });

    // Swipe on touch screens and with a mouse drag
    let startX = 0;
    let tracking = false;
    let swiped = false;

    viewport.addEventListener("pointerdown", (e) => {
      // Don't treat scrolling inside an opened description as a swipe
      if ((e.target as HTMLElement).closest(".vt-desc.is-open, .vt-more")) return;
      tracking = true;
      swiped = false;
      startX = e.clientX;
    });
    viewport.addEventListener("pointerup", (e) => {
      if (!tracking) return;
      tracking = false;
      const diff = e.clientX - startX;
      if (Math.abs(diff) < 50) return;
      swiped = true;
      move(diff < 0 ? 1 : -1);
      setTimeout(() => (swiped = false), 0);
    });
    viewport.addEventListener("pointercancel", () => (tracking = false));
    viewport.addEventListener(
      "click",
      (e) => {
        if (swiped) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true
    );

    window.addEventListener("resize", () => {
      setX(0, false);
      sync();
      measure();
    });

    buildDots();
    setX(0, false);
    sync();
  }
</script>