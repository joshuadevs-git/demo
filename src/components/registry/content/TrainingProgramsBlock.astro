---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";

// `icon` is the inner markup of a 24x24 stroke icon (Lucide-style)
const programs = [
  {
    title: "Legal Intake Qualifier",
    description:
      "Answer new inquiries, collect key details, and screen potential clients against the firm's requirements.",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m16 11 2 2 4-4"/>`,
  },
  {
    title: "Legal Intake Closer",
    description:
      "Build trust, handle objections, follow up on leads, and guide qualified prospects through onboarding.",
    icon: `<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>`,
  },
  {
    title: "Medical Records Retriever",
    description:
      "Request, collect, organize, and track medical records, and chase down missing documents.",
    icon: `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>`,
  },
  {
    title: "Paralegal Support",
    description:
      "Learn legal research, document prep, case documentation, correspondence, and attorney support.",
    icon: `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>`,
  },
  {
    title: "Legal Case Manager",
    description:
      "Coordinate cases, talk to clients, track deadlines, and monitor progress in legal management systems.",
    icon: `<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>`,
  },
  {
    title: "Legal Assistant / Administrative Support",
    description:
      "Manage calendars and emails, organize documents, and keep a law firm running smoothly.",
    icon: `<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>`,
  },
];
---

<Section tone="page" class="border-t border-brand-dark/10">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <Text
        tag="p"
        variant="accent-label"
        class="font-sans font-semibold tracking-[0.18em] text-[#FF8A00] md:text-[0.72rem]"
      >
        TRAINING PROGRAMS
      </Text>

      <Heading
        tag="h2"
        variant="section-heading-xl"
        class="mt-4 !font-extrabold !leading-[1.1] !text-brand-dark"
      >
        Pick the Legal VA Career Path That Fits You.
      </Heading>

      <Text variant="body" class="mx-auto mt-5 max-w-2xl leading-7">
        Every program is built around the real tasks of a real legal support job.
      </Text>
    </div>

    <div class="programs-carousel mt-12" data-carousel>
      <div
        class="programs-track"
        data-track
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="Training programs"
      >
        {programs.map((program, index) => (
          <article
            class="program-card"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${programs.length}`}
          >
            <span class="program-icon">
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={program.icon}
              />
            </span>

            <h3 class="mt-6 text-lg font-bold leading-snug text-brand-dark">
              {program.title}
            </h3>

            <p class="mt-3 text-sm leading-6 text-brand-dark/65">
              {program.description}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-6 flex items-center justify-center gap-4">
        <button type="button" class="carousel-btn" data-prev aria-label="Previous programs">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>

        <div class="flex items-center gap-2" aria-hidden="true">
          {programs.map(() => <span class="carousel-dot"></span>)}
        </div>

        <button type="button" class="carousel-btn" data-next aria-label="Next programs">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>

    <div class="mt-12 flex justify-center">
      <Button href="#contact" variant="primary" size="lg">
        Explore Our Training Options
      </Button>
    </div>
  </Container>
</Section>

<style>
  .programs-track {
    --gap: 1.25rem;
    --per-view: 1;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* breathing room so the soft shadow isn't clipped */
    padding: 1rem 0.5rem 2rem;
    margin: -1rem -0.5rem -2rem;
    outline: none;
  }
  .programs-track::-webkit-scrollbar {
    display: none;
  }
  .programs-track:focus-visible {
    outline: 2px solid #ff8a00;
    outline-offset: 4px;
    border-radius: 1rem;
  }

  @media (min-width: 640px) {
    .programs-track { --per-view: 2; }
  }
  @media (min-width: 1024px) {
    .programs-track { --per-view: 3; }
  }
  @media (min-width: 1280px) {
    .programs-track { --per-view: 4; }
  }

  .program-card {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    scroll-snap-align: start;
    min-height: 15rem;
    padding: 1.9rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 138, 0, 0.2);
    background: #fff;
    box-shadow: 0 10px 30px -14px rgba(255, 138, 0, 0.28);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .program-card:hover {
      border-color: rgba(255, 138, 0, 0.45);
      box-shadow: 0 14px 34px -14px rgba(255, 138, 0, 0.4);
    }
  }

  .program-icon {
    display: flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 138, 0, 0.25);
    background: #fff0dd;
    color: #ff8a00;
  }

  .carousel-btn {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(18, 33, 63, 0.15);
    background: #fff;
    color: #12213f;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .carousel-btn:hover:not(:disabled) {
    background: #ff8a00;
    border-color: #ff8a00;
    color: #fff;
  }
  .carousel-btn:focus-visible {
    outline: 2px solid #ff8a00;
    outline-offset: 2px;
  }
  .carousel-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .carousel-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgba(18, 33, 63, 0.18);
    transition: width 0.25s ease, background 0.25s ease;
  }
  .carousel-dot.is-active {
    width: 1.5rem;
    background: #ff8a00;
  }

  @media (prefers-reduced-motion: reduce) {
    .programs-track { scroll-behavior: auto; }
    .program-card, .carousel-dot { transition: none; }
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";

      const track = root.querySelector<HTMLElement>("[data-track]");
      const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
      const next = root.querySelector<HTMLButtonElement>("[data-next]");
      const dots = Array.from(root.querySelectorAll<HTMLElement>(".carousel-dot"));
      if (!track || !prev || !next) return;

      const cards = Array.from(track.children) as HTMLElement[];

      const step = () => {
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return cards[0].getBoundingClientRect().width + gap;
      };

      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft >= max - 4;

        const trackLeft = track.getBoundingClientRect().left;
        const trackRight = trackLeft + track.clientWidth;
        cards.forEach((card, i) => {
          const r = card.getBoundingClientRect();
          const visible = r.left >= trackLeft - 8 && r.right <= trackRight + 8;
          dots[i]?.classList.toggle("is-active", visible);
        });
      };

      prev.addEventListener("click", () =>
        track.scrollBy({ left: -step(), behavior: "smooth" }),
      );
      next.addEventListener("click", () =>
        track.scrollBy({ left: step(), behavior: "smooth" }),
      );

      track.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") { e.preventDefault(); next.click(); }
        if (e.key === "ArrowLeft") { e.preventDefault(); prev.click(); }
      });

      track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
      window.addEventListener("resize", update);
      update();
    });
  }

  initCarousels();
  document.addEventListener("astro:page-load", initCarousels);
</script>