---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";

// `icon` is the inner markup of a 24x24 stroke icon (Lucide-style)
const benefits = [
  {
    title: "Partner agency opportunities",
    description:
      "Qualified graduates get priority consideration for endorsement when a suitable role opens.",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    title: "TESDA-accredited training",
    description:
      "A TESDA-accredited training center in the Philippines, following recognized quality standards.",
    icon: `<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    title: "LGU sponsorship opportunities",
    description:
      "We partner with Local Government Units to help qualified people access training.",
    icon: `<path d="M3 22h18"/><path d="M6 18v-7"/><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M12 2 20 7H4Z"/>`,
  },
  {
    title: "Small live batches",
    description:
      "Only 10 trainees per live batch, for more attention and better coaching.",
    icon: `<path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/>`,
  },
  {
    title: "Practical, industry-based training",
    description:
      "Real workflows, hands-on CRM practice, mock calls, and realistic work scenarios.",
    icon: `<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/>`,
  },
  {
    title: "Career preparation and support",
    description:
      "Help with your resume, video introduction, and interview practice.",
    icon: `<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>`,
  },
];
---

<Section id="career-opportunities" tone="page" class="relative overflow-hidden border-t border-brand-dark/10">
  <Container>
    <div class="career-wrap" data-career-wrap>
      <div class="mx-auto max-w-3xl text-center">
        <Text
          tag="p"
          variant="accent-label"
          class="font-sans font-semibold tracking-[0.18em] text-[#FF8A00]"
        >
          <span class="career-eyebrow" data-career-reveal style="--i:0">CAREER OPPORTUNITIES</span>
        </Text>

        <span class="career-eyebrow-line" aria-hidden="true"></span>

        <Heading
          tag="h2"
          variant="section-heading-xl"
          class="mt-4 !font-extrabold !leading-[1.1] !text-brand-dark"
        >
          <span class="career-heading" data-career-reveal style="--i:1">
            We Don't Stop at Training. We Help You Move Toward a Job.
          </span>
        </Heading>
      </div>

      <div class="career-carousel mt-12" data-carousel>
        <div
          class="career-track"
          data-track
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="Career opportunities and benefits"
        >
          {benefits.map((benefit, index) => (
            <article
              class="career-card"
              data-career-reveal
              style={`--i:${index + 2}`}
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${benefits.length}`}
            >
              <span class="career-icon">
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={benefit.icon}
                />
              </span>

              <h3 class="mt-6 text-lg font-bold leading-snug text-brand-dark">
                {benefit.title}
              </h3>

              <p class="mt-3 text-sm leading-6 text-brand-dark/65">
                {benefit.description}
              </p>
            </article>
          ))}
        </div>

        <div class="mt-6 flex items-center justify-center gap-4">
          <button type="button" class="carousel-btn" data-prev aria-label="Previous benefits">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>

          <div class="flex items-center gap-2" aria-hidden="true">
            {benefits.map(() => <span class="carousel-dot"></span>)}
          </div>

          <button type="button" class="carousel-btn" data-next aria-label="Next benefits">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .career-wrap {
    position: relative;
    isolation: isolate;
  }

  /* Soft orange glow that drifts slowly behind the cards */
  .career-wrap::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -8rem;
    right: -8rem;
    width: 32rem;
    height: 32rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 138, 0, 0.16) 0%, rgba(255, 138, 0, 0) 65%);
    pointer-events: none;
    animation: career-glow 10s ease-in-out infinite alternate;
  }

  /* Small orange line that draws itself under the eyebrow */
  .career-eyebrow-line {
    display: block;
    width: 3.5rem;
    height: 3px;
    margin: 0.9rem auto 0;
    border-radius: 999px;
    background: #ff8a00;
    transform-origin: center;
  }

  /* ---------- Carousel track ---------- */
  .career-track {
    --gap: 1.25rem;
    --per-view: 1;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* room so the soft shadow and reveal motion aren't clipped */
    padding: 1rem 0.5rem 2.5rem;
    margin: -1rem -0.5rem -2.5rem;
    outline: none;
  }
  .career-track::-webkit-scrollbar {
    display: none;
  }
  .career-track:focus-visible {
    outline: 2px solid #ff8a00;
    outline-offset: 4px;
    border-radius: 1rem;
  }

  @media (min-width: 640px) {
    .career-track { --per-view: 2; }
  }
  @media (min-width: 1024px) {
    .career-track { --per-view: 3; }
  }
  @media (min-width: 1280px) {
    .career-track { --per-view: 4; }
  }

  /* ---------- Cards ---------- */
  .career-card {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    scroll-snap-align: start;
    min-height: 15rem;
    padding: 1.9rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 138, 0, 0.2);
    background: #fff;
    box-shadow: 0 10px 30px -14px rgba(255, 138, 0, 0.28);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .career-icon {
    display: flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 138, 0, 0.25);
    background: #fff0dd;
    color: #ff8a00;
    transition: transform 300ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .career-card:hover {
      border-color: rgba(255, 138, 0, 0.45);
      box-shadow: 0 14px 34px -14px rgba(255, 138, 0, 0.4);
    }
    .career-card:hover .career-icon {
      transform: translateY(-2px) scale(1.05);
    }
  }

  /* ---------- Controls ---------- */
  .carousel-btn {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(18, 33, 63, 0.15);
    background: #fff;
    color: #12213f;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .carousel-btn:hover:not(:disabled) {
    background: #ff8a00;
    border-color: #ff8a00;
    color: #fff;
  }
  .carousel-btn:focus-visible {
    outline: 2px solid #ff8a00;
    outline-offset: 2px;
  }
  .carousel-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .carousel-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgba(18, 33, 63, 0.18);
    transition: width 0.25s ease, background 0.25s ease;
  }
  .carousel-dot.is-active {
    width: 1.5rem;
    background: #ff8a00;
  }

  /* ---------- Scroll reveal ----------
     Hidden only after the script has loaded, so content is never stuck invisible. */
  .career-wrap.is-armed [data-career-reveal] {
    opacity: 0;
    transform: translateY(32px) scale(0.97);
    transition:
      opacity 700ms ease,
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.25s ease,
      box-shadow 0.25s ease;
    transition-delay: calc(var(--i, 0) * 100ms);
  }
  .career-wrap.is-armed .career-eyebrow,
  .career-wrap.is-armed .career-heading {
    display: inline-block;
  }
  .career-wrap.is-armed.is-visible [data-career-reveal] {
    opacity: 1;
    transform: none;
  }
  /* After the reveal, hover should respond instantly */
  .career-wrap.is-visible .career-card:hover {
    transition-delay: 0ms;
  }

  .career-wrap.is-armed .career-eyebrow-line {
    transform: scaleX(0);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1) 250ms;
  }
  .career-wrap.is-armed.is-visible .career-eyebrow-line {
    transform: scaleX(1);
  }

  @keyframes career-glow {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(-3rem, 3rem) scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-wrap::before { animation: none; }
    .career-track { scroll-behavior: auto; }
    .career-card,
    .career-icon,
    .carousel-dot,
    .career-wrap.is-armed [data-career-reveal],
    .career-wrap.is-armed .career-eyebrow-line {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .career-card:hover .career-icon {
      transform: none;
    }
  }
</style>

<script>
  function initCareer() {
    const careerWrap = document.querySelector<HTMLElement>("[data-career-wrap]");
    if (!careerWrap || careerWrap.dataset.ready) return;
    careerWrap.dataset.ready = "true";

    /* ----- Scroll reveal ----- */
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) {
      careerWrap.classList.add("is-visible");
    } else {
      careerWrap.classList.add("is-armed");
      const careerObserver = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            careerWrap.classList.add("is-visible");
            careerObserver.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      careerObserver.observe(careerWrap);
    }

    /* ----- Carousel ----- */
    const root = careerWrap.querySelector<HTMLElement>("[data-carousel]");
    const track = root?.querySelector<HTMLElement>("[data-track]");
    const prev = root?.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root?.querySelector<HTMLButtonElement>("[data-next]");
    if (!root || !track || !prev || !next) return;

    const dots = Array.from(root.querySelectorAll<HTMLElement>(".carousel-dot"));
    const cards = Array.from(track.children) as HTMLElement[];

    const step = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return cards[0].getBoundingClientRect().width + gap;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= max - 4;

      const trackLeft = track.getBoundingClientRect().left;
      const trackRight = trackLeft + track.clientWidth;
      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        const visible = r.left >= trackLeft - 8 && r.right <= trackRight + 8;
        dots[i]?.classList.toggle("is-active", visible);
      });
    };

    prev.addEventListener("click", () =>
      track.scrollBy({ left: -step(), behavior: "smooth" }),
    );
    next.addEventListener("click", () =>
      track.scrollBy({ left: step(), behavior: "smooth" }),
    );

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); next.click(); }
      if (e.key === "ArrowLeft") { e.preventDefault(); prev.click(); }
    });

    track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  initCareer();
  document.addEventListener("astro:page-load", initCareer);
</script>