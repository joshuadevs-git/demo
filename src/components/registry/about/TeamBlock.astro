---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import jsonData from "@data/sections/nova-team.json";
import { ACTIVE_TEMPLATE } from "@config/template";

interface TeamAvatar { src: string; alt: string; }
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  closing?: string;
  image?: string;
  imageAlt?: string;
  checks?: string[];
  buttonLabel?: string;
  buttonHref?: string;
  videoCaption?: string;
  // kept so existing callers don't break (not rendered anymore)
  teamLabel?: string;
  teamCount?: string;
  teamAriaLabel?: string;
  teamAvatars?: TeamAvatar[];
  class?: string;
}

const props = Astro.props as Props;
const fallback = ACTIVE_TEMPLATE === "nova" ? undefined : jsonData;

const eyebrow = props.eyebrow ?? fallback?.eyebrow;
const title = props.title ?? fallback?.title;
const description = props.description ?? fallback?.description;
const closing = props.closing ?? (fallback as any)?.closing;
const image = props.image ?? (fallback as any)?.image;
const imageAlt = props.imageAlt ?? (fallback as any)?.imageAlt ?? "";
const videoCaption = props.videoCaption ?? (fallback as any)?.videoCaption;

// Each blank-line / new-line in the JSON becomes its own paragraph
const paragraphs = (description ?? "").split(/\n+/).map((p) => p.trim()).filter(Boolean);
---

<Section id="zespol" tone="page" class:list={["nova-team py-16 md:py-24", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-16">

      <!-- VIDEO: boxed card, click to play with sound -->
      <div class="nova-team-media relative flex justify-center" data-motion="viewport" data-motion-skip>
        <div class="relative w-full h-[30rem] max-w-[50rem]">
        <figure
          data-team-video-root
          class="relative m-0 w-full cursor-pointer overflow-hidden rounded-2xl bg-[#12213F] shadow-[0_24px_48px_-18px_rgba(18,33,63,0.5)]"
        >
          <video
            data-team-video
            src={image}
            loop
            playsinline
            webkit-playsinline
            muted
            preload="auto"
            class="relative block h-[28rem] w-full [aspect-ratio:auto_16/9]"
          >
            <p>{imageAlt}</p>
          </video>

          <!-- Play button overlay -->
          <div
            data-team-overlay
            role="button"
            tabindex="0"
            aria-label="Play video with sound"
            class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-[#12213F]/35 transition-opacity duration-300"
          >
            <div class="flex size-16 items-center justify-center rounded-full bg-white text-[#12213F] shadow-lg transition-transform duration-300 hover:scale-105">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="ml-1 size-7" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
            {videoCaption && (
              <span class="px-4 text-center text-sm font-medium tracking-wide text-white">{videoCaption}</span>
            )}
          </div>
        </figure>
        </div>
      </div>

      <!-- STORY -->
      <div class="flex min-w-0 flex-col gap-5" data-motion-sequence="viewport" data-motion-profile="soft">

        {eyebrow && (
          <Text tag="p" variant="accent-label" class="font-sans text-sm font-semibold tracking-[0.18em] text-[#B35F00]">
            {eyebrow}
          </Text>
        )}

        <Heading tag="h2" variant="section-title" class="[text-wrap:balance]">{title}</Heading>

        <div class="flex flex-col gap-4">
          {paragraphs.map((p) => (
            <Text variant="lead" class="max-w-[38rem] text-[#12213F]/75">{p}</Text>
          ))}
        </div>

        

        {closing && (
          <blockquote class="nova-team-closing m-0 max-w-[38rem] border-l-4 border-[#FF8A00] py-1 pl-5">
            <Heading tag="p" variant="feature-title" class="!text-[clamp(1.2rem,1.8vw,1.55rem)] !leading-snug font-bold text-[#12213F] [text-wrap:balance]">
              {closing}
            </Heading>
          </blockquote>
        )}
    
      </div>
    </div>
  </Container>
</Section>

<script>
  // Runs on first load AND after every Astro page navigation.
  function initTeamVideo() {
    document.querySelectorAll<HTMLElement>("[data-team-video-root]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";

      const video = root.querySelector<HTMLVideoElement>("[data-team-video]");
      const overlay = root.querySelector<HTMLElement>("[data-team-overlay]");
      if (!video || !overlay) return;

      const showOverlay = () => {
        overlay.style.opacity = "1";
        overlay.style.pointerEvents = "auto";
      };
      const hideOverlay = () => {
        overlay.style.opacity = "0";
        overlay.style.pointerEvents = "none";
      };

      // Play with sound. Recovers from every failure instead of needing a page refresh.
      const start = async () => {
        video.muted = false;
        video.volume = 1;
        try {
          await video.play();
          return;
        } catch (err) {
          // Browser refused sound -> try muted
          if ((err as DOMException)?.name === "NotAllowedError") {
            video.muted = true;
            try {
              await video.play();
              return;
            } catch {}
          }
        }
        // Stuck / stalled / aborted state -> reload the file at the same spot and retry
        const t = video.currentTime;
        video.load();
        video.addEventListener(
          "loadedmetadata",
          async () => {
            try {
              video.currentTime = t;
              await video.play();
            } catch {}
          },
          { once: true }
        );
      };

      // One handler for the whole card: tap to play, tap again to pause
      root.addEventListener("click", () => {
        if (video.paused) start();
        else video.pause();
      });
      overlay.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          start();
        }
      });

      // Overlay always mirrors the real video state
      video.addEventListener("play", hideOverlay);
      video.addEventListener("playing", hideOverlay);
      video.addEventListener("pause", showOverlay);
      video.addEventListener("ended", showOverlay);

      // If the file fails to load, retry once automatically
      let retried = false;
      video.addEventListener("error", () => {
        if (retried) return;
        retried = true;
        video.load();
      });

      if (video.paused) showOverlay();
      else hideOverlay();
    });
  }

  initTeamVideo();
  document.addEventListener("astro:page-load", initTeamVideo);
</script>