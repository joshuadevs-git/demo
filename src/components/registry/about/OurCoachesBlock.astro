---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/our-coaches.json";

interface Coach {
  name: string;
  role: string;
  headline?: string;
  description: string;
  image: string;
}

interface TrainingItem {
  title: string;
  text: string;
}

interface Training {
  eyebrow: string;
  heading: string;
  intro: string;
  items: TrainingItem[];
  tools: string[];
  image: string;
  imageAlt?: string;
}

interface Props {
  id?: string;
  locale?: "en";
  eyebrow?: string;
  heading?: string;
  coaches?: Coach[];
  training?: Training;
  previousLabel?: string;
  nextLabel?: string;
  slideLabel?: string;
  headingTag?: string;
  class?: string;
}

const props = Astro.props as Props;

const eyebrow = props.eyebrow ?? jsonData.eyebrow;
const heading = props.heading ?? jsonData.heading;
const coaches: Coach[] = props.coaches ?? jsonData.coaches;
const training: Training | undefined = props.training ?? (jsonData as any).training;
const previousLabel = props.previousLabel ?? jsonData.previousLabel;
const nextLabel = props.nextLabel ?? jsonData.nextLabel;
const slideLabel = props.slideLabel ?? jsonData.slideLabel;
const HeadingTag = (props.headingTag ?? "h2") as any;

const total = coaches.length;
const half = Math.floor(total / 2);

// Position of each card relative to the active one (-2..2, anything else hidden)
const posOf = (i: number) => {
  const p = ((i + half) % total) - half;
  return Math.abs(p) > 2 ? "hidden" : String(p);
};
---

<Section
  id={props.id ?? "our-coaches"}
  tone="page"
  class:list={["our-coaches-section relative overflow-hidden py-20 md:py-28", props.class]}
>
  <Container class="w-full max-w-none px-5 md:px-10">
    {total > 0 && (
      <div
        class="coach-carousel relative mx-auto"
        data-coach-carousel
        tabindex="0"
        aria-roledescription="carousel"
        aria-label="Our coaches carousel"
      >
        <Text tag="p" variant="accent-label" class="font-sans font-semibold tracking-[0.18em] text-[#FF8A00] md:text-[0.72rem] lg:text-[clamp(0.75rem,0.85vw,0.95rem)]">
          {eyebrow}
        </Text>

        <!-- Big faded background title -->
        <HeadingTag class="coach-bg-title">{heading}</HeadingTag>

        <!-- Cards -->
        <div class="coach-stage-wrap">
          <button
            type="button"
            class="coach-arrow coach-arrow-prev"
            data-coach-prev
            aria-label={previousLabel}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-5">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>

          <div class="coach-stage">
            {coaches.map((coach, index) => (
              <article
                class="coach-card"
                data-coach-card
                data-index={index}
                data-pos={posOf(index)}
                aria-label={`${slideLabel}: ${coach.name}`}
              >
                <img
                  src={coach.image}
                  alt={coach.name}
                  class="h-full w-full object-cover"
                  loading={index === 0 ? "eager" : "lazy"}
                  draggable="false"
                />
              </article>
            ))}
          </div>

          <button
            type="button"
            class="coach-arrow coach-arrow-next"
            data-coach-next
            aria-label={nextLabel}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-5">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>

        <!-- Info: name → position → description -->
        <div class="coach-info-grid" aria-live="polite">
          {coaches.map((coach, index) => (
            <div
              class:list={["coach-info", index === 0 ? "is-active" : ""]}
              data-coach-info
              data-index={index}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div class="coach-name-row">
                <span class="coach-line"></span>
                <h3 class="coach-name">{coach.name}</h3>
                <span class="coach-line"></span>
              </div>
              <p class="coach-role">{coach.role}</p>
              <p class="coach-description">{coach.description}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </Container>
</Section>

{training && (
  <section id="how-our-training-works" class="training-section">
    <Container class="w-full max-w-none px-5 md:px-10">
      <div class="training-grid mx-auto">
        <div class="training-copy">
          <p class="training-eyebrow" data-reveal style="--i:0">{training.eyebrow}</p>
          <h2 class="training-heading" data-reveal style="--i:1">{training.heading}</h2>
          <p class="training-intro" data-reveal style="--i:2">{training.intro}</p>

          <ul class="training-list">
            {training.items.map((item, i) => (
              <li data-reveal style={`--i:${3 + i}`}>
                <span class="training-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                </span>
                <p><strong>{item.title}</strong> {item.text}</p>
              </li>
            ))}
          </ul>

          <ul class="training-tools" aria-label="CRM platforms">
            {training.tools.map((tool, i) => (
              <li data-reveal style={`--i:${6 + i}`}>{tool}</li>
            ))}
          </ul>
        </div>

        <div class="training-photo" data-reveal="photo" style="--i:2">
          <img src={training.image} alt={training.imageAlt ?? ""} loading="lazy" draggable="false" />
        </div>
      </div>
    </Container>
  </section>
)}

<style>
  .coach-carousel {
    --accent: #f97316;
    --accent-dark: #ea7a0b;
    --w: clamp(200px, 62vw, 310px);
    max-width: 1100px;
    outline: none;
    text-align: center;
    user-select: none;
    touch-action: pan-y;
  }

  .coach-eyebrow {
    position: relative;
    z-index: 2;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }

  /* ---------- Big faded title behind the cards ---------- */
  .coach-bg-title {
    position: relative;
    z-index: 0;
    margin: 0 0 -0.42em;
    font-size: clamp(3rem, 11vw, 8.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    background: linear-gradient(to bottom, rgba(249, 115, 22, 0.75) 0%, rgba(249, 115, 22, 0) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    pointer-events: none;
  }

  /* ---------- Stage ---------- */
  .coach-stage-wrap {
    position: relative;
    z-index: 1;
  }

  .coach-stage {
    position: relative;
    height: calc(var(--w) * 1.364);
  }

  .coach-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--w);
    height: calc(var(--w) * 1.364);
    overflow: hidden;
    border-radius: 1.25rem;
    background: #e2e8f0;
    box-shadow: 0 20px 45px -12px rgba(15, 23, 42, 0.3);
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    filter: grayscale(1) brightness(0.8);
    transition:
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 500ms ease,
      filter 500ms ease,
      visibility 500ms;
    will-change: transform, opacity;
  }

  .coach-card[data-pos="0"] {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    visibility: visible;
    filter: none;
    z-index: 3;
  }

  .coach-card[data-pos="-1"],
  .coach-card[data-pos="1"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    cursor: pointer;
    z-index: 2;
  }
  .coach-card[data-pos="-1"] {
    transform: translate(calc(-50% - var(--w) * 0.61), -50%) scale(0.74);
  }
  .coach-card[data-pos="1"] {
    transform: translate(calc(-50% + var(--w) * 0.61), -50%) scale(0.74);
  }

  .coach-card[data-pos="-2"],
  .coach-card[data-pos="2"] {
    opacity: 0.9;
    visibility: visible;
    pointer-events: auto;
    cursor: pointer;
    z-index: 1;
  }
  .coach-card[data-pos="-2"] {
    transform: translate(calc(-50% - var(--w) * 0.97), -50%) scale(0.56);
  }
  .coach-card[data-pos="2"] {
    transform: translate(calc(-50% + var(--w) * 0.97), -50%) scale(0.56);
  }

  /* ---------- Arrows ---------- */
  .coach-arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 8px 18px -6px rgba(234, 88, 12, 0.6);
    transform: translateY(-50%);
    transition: background 250ms ease, transform 250ms ease;
  }
  .coach-arrow:hover {
    background: var(--accent-dark);
    transform: translateY(-50%) scale(1.08);
  }
  .coach-arrow:focus-visible {
    outline: 2px solid var(--accent-dark);
    outline-offset: 3px;
  }
  .coach-arrow-prev { left: 0; }
  .coach-arrow-next { right: 0; }

  @media (min-width: 1024px) {
    .coach-arrow-prev { left: 4%; }
    .coach-arrow-next { right: 4%; }
  }

  /* ---------- Info below the cards ---------- */
  .coach-info-grid {
    display: grid;
    margin-top: 2.5rem;
  }

  .coach-info {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 400ms ease, transform 400ms ease, visibility 400ms;
  }
  .coach-info.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .coach-name-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .coach-name {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .coach-line {
    display: block;
    width: clamp(36px, 9vw, 100px);
    height: 2px;
    background: var(--accent);
  }

  .coach-role {
    margin: 0.35rem 0 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #64748b;
  }

  .coach-description {
    max-width: 38rem;
    margin: 1rem auto 0;
    font-size: 0.975rem;
    line-height: 1.75;
    color: #475569;
  }

  @media (prefers-reduced-motion: reduce) {
    .coach-card,
    .coach-info,
    .coach-arrow {
      transition: none;
    }
  }

  /* ---------- How our training works ---------- */
  .training-section {
    position: relative;
    overflow: hidden;
    padding: 5rem 0;
    background: #12213f;
    color: #fff;
  }
  @media (min-width: 768px) {
    .training-section {
      padding: 7rem 0;
    }
  }

  .training-grid {
    display: grid;
    align-items: center;
    gap: 2.5rem;
    max-width: 1100px;
  }
  @media (min-width: 900px) {
    .training-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .training-eyebrow {
    margin: 0;
    color: #ff8a00;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .training-heading {
    margin: 1rem 0 0;
    color: #fff;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .training-intro {
    margin: 1.25rem 0 0;
    color: #d5dcea;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .training-list {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .training-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .training-list p {
    margin: 0;
    color: #d5dcea;
    line-height: 1.55;
  }
  .training-list strong {
    color: #fff;
    font-weight: 700;
  }

  .training-check {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    border-radius: 999px;
    background: #ff8a00;
    color: #fff;
  }
  .training-check svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .training-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .training-tools li {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: #fff;
    color: #12213f;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .training-photo {
    overflow: hidden;
    border-radius: 1.5rem;
    aspect-ratio: 4 / 5;
    background: #1b2d52;
  }
  .training-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Training animations ---------- */
  .training-section::before {
    content: "";
    position: absolute;
    top: -12rem;
    right: -10rem;
    width: 38rem;
    height: 38rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 138, 0, 0.28) 0%, rgba(255, 138, 0, 0) 65%);
    pointer-events: none;
    animation: training-glow 9s ease-in-out infinite alternate;
  }
  .training-grid {
    position: relative;
    z-index: 1;
  }

  /* Elements are hidden only once the script has loaded, so the content is never stuck invisible */
  .training-section.is-armed [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 700ms ease,
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 100ms);
  }
  .training-section.is-armed [data-reveal="photo"] {
    transform: translateX(48px) scale(0.95);
  }
  .training-section.is-armed.is-visible [data-reveal] {
    opacity: 1;
    transform: none;
  }

  /* Photo: slow zoom-out while it slides in */
  .training-section.is-armed .training-photo img {
    transform: scale(1.15);
    transition: transform 1600ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 200ms;
  }
  .training-section.is-armed.is-visible .training-photo img {
    transform: scale(1);
  }

  /* Check circles pop in */
  .training-section.is-armed .training-check {
    transform: scale(0);
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i, 0) * 100ms + 250ms);
  }
  .training-section.is-armed.is-visible .training-check {
    transform: scale(1);
  }

  /* Pills lift on hover */
  .training-tools li {
    cursor: default;
  }
  .training-section.is-visible .training-tools li:hover {
    transform: translateY(-3px);
    background: #ff8a00;
    color: #fff;
    transition-delay: 0ms;
    transition-duration: 200ms;
  }

  @keyframes training-glow {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(-3rem, 2.5rem) scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .training-section::before { animation: none; }
    .training-section.is-armed [data-reveal],
    .training-section.is-armed .training-photo img,
    .training-section.is-armed .training-check {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>



<script>
  document.querySelectorAll<HTMLElement>("[data-coach-carousel]").forEach((carousel) => {
    if (carousel.dataset.initialized === "true") return;
    carousel.dataset.initialized = "true";

    const cards = Array.from(carousel.querySelectorAll<HTMLElement>("[data-coach-card]"));
    const infos = Array.from(carousel.querySelectorAll<HTMLElement>("[data-coach-info]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-coach-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-coach-next]");

    const total = cards.length;
    if (total === 0) return;

    const half = Math.floor(total / 2);
    let activeIndex = 0;
    let startX = 0;
    let pointerDown = false;
    let dragged = false;

    function update() {
      cards.forEach((card, index) => {
        const d = (((index - activeIndex) % total) + total) % total;
        const pos = ((d + half) % total) - half;
        card.dataset.pos = Math.abs(pos) > 2 ? "hidden" : String(pos);
      });

      infos.forEach((info, index) => {
        const isActive = index === activeIndex;
        info.classList.toggle("is-active", isActive);
        info.setAttribute("aria-hidden", isActive ? "false" : "true");
      });
    }

    function goTo(index: number) {
      activeIndex = (index + total) % total;
      update();
    }

    previous?.addEventListener("click", () => goTo(activeIndex - 1));
    next?.addEventListener("click", () => goTo(activeIndex + 1));

    cards.forEach((card, index) => {
      card.addEventListener("click", () => {
        if (dragged) return;
        if (index !== activeIndex) goTo(index);
      });
    });

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(activeIndex - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(activeIndex + 1);
      }
    });

    carousel.addEventListener("pointerdown", (event) => {
      pointerDown = true;
      dragged = false;
      startX = event.clientX;
    });

    carousel.addEventListener("pointerup", (event) => {
      if (!pointerDown) return;
      pointerDown = false;

      const difference = event.clientX - startX;
      if (Math.abs(difference) < 45) return;

      dragged = true;
      setTimeout(() => (dragged = false), 0);
      goTo(difference < 0 ? activeIndex + 1 : activeIndex - 1);
    });

    carousel.addEventListener("pointercancel", () => {
      pointerDown = false;
    });

    update();
  });

  /* ---------- Training section: reveal on scroll ---------- */
  const trainingSection = document.querySelector<HTMLElement>("#how-our-training-works");
  if (trainingSection) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) {
      trainingSection.classList.add("is-visible");
    } else {
      trainingSection.classList.add("is-armed");
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            trainingSection.classList.add("is-visible");
            observer.disconnect();
          }
        },
        { threshold: 0.2 }
      );
      observer.observe(trainingSection);
    }
  }
</script>