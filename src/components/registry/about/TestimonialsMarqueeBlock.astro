---
import Section from "@components/ui/layout/Section.astro";
import testimonialsData from "@data/sections/testimonials.json";

// Why: content comes from the "testimonial-v2" block in the JSON file.
// Adjust the key/path if your JSON nests it differently.
const data = (testimonialsData as Record<string, any>)["testimonial-v2"] ?? {};

interface Testimonial {
    quote: string;
    author: string;
    initials?: string;
    role: string;
    avatar?: string;
}

interface Props {
    title?: string;
    description?: string;
    tagline?: string;
    testimonials?: Testimonial[];
    /** Section heading tag: 'h2' by default, 'h1' when the block is the first section without hero (SEO). */
    headingTag?: "h1" | "h2";
    class?: string;
}

const {
    title = data.title,
    description = data.description,
    tagline = data.tagline,
    testimonials = [],
    headingTag = "h2",
    class: className = "",
} = Astro.props;

const avatarAltPrefix: string = data.avatarAltPrefix ?? "Photo of";
const list: Testimonial[] = testimonials.length > 0 ? testimonials : data.items ?? [];
const Heading = headingTag;
const uid = `t2-${Math.random().toString(36).slice(2, 8)}`;
---

<Section tone="page" class:list={["bg-white overflow-hidden", className]}>
    <div class="ui-container" data-testimonial-v2 id={uid}>
        <!-- Header -->
        <div class="mx-auto max-w-2xl text-center">
            {tagline && (
                <p class="text-sm font-semibold uppercase tracking-[0.12em] text-neutral-800">{tagline}</p>
            )}
            <Heading class="mt-3 text-3xl font-bold text-orange-500 md:text-4xl">{title}</Heading>
            {description && <p class="mt-4 text-sm leading-relaxed text-neutral-600 md:text-base">{description}</p>}
        </div>

        <!-- Track -->
        <div class="relative mt-16">
            <ul
                data-track
                class="t2-track flex snap-x snap-mandatory gap-6 overflow-x-auto px-[max(1rem,calc(50%-10rem))] pb-4 pt-10"
                aria-label={title}
            >
                {list.map((item) => (
                    <li class="w-80 shrink-0 snap-center">
                        <article class="t2-card relative h-full rounded-3xl px-6 pb-7 pt-12 text-center">
                            <div class="t2-avatar absolute left-1/2 top-0 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center overflow-hidden rounded-full bg-orange-100 text-sm font-semibold text-orange-600">
                                <span aria-hidden="true">{item.initials}</span>
                                {item.avatar && (
                                    <img
                                        src={item.avatar}
                                        alt={`${avatarAltPrefix} ${item.author}`}
                                        width="56"
                                        height="56"
                                        loading="lazy"
                                        class="absolute inset-0 h-full w-full object-cover"
                                    />
                                )}
                            </div>

                            <blockquote>
                                <p data-quote class="t2-quote text-sm leading-relaxed text-neutral-700">
                                    {item.quote}
                                </p>
                            </blockquote>

                            <button
                                type="button"
                                data-toggle
                                hidden
                                aria-expanded="false"
                                class="mt-2 text-xs font-semibold text-orange-500 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-500"
                            >
                                See more
                            </button>

                            <p class="mt-5 text-base font-bold text-orange-500">{item.author}</p>
                            <p class="mt-0.5 text-xs text-neutral-500">{item.role}</p>
                        </article>
                    </li>
                ))}
            </ul>
        </div>

        <!-- Controls -->
        <div class="mt-6 flex justify-center gap-3">
            <button type="button" data-prev aria-label="Previous review" class="t2-nav">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
            </button>
            <button type="button" data-next aria-label="Next review" class="t2-nav">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
        </div>
    </div>
</Section>

<style>
    .t2-track {
        scrollbar-width: none;
        scroll-behavior: smooth;
    }
    .t2-track::-webkit-scrollbar {
        display: none;
    }

    /* Glass card: translucent fill + blur + soft border, tuned for a white page */
    .t2-card {
        background: linear-gradient(160deg, rgb(255 255 255 / 0.9), rgb(255 247 237 / 0.55));
        border: 1px solid rgb(251 146 60 / 0.35);
        box-shadow:
            0 10px 30px -12px rgb(249 115 22 / 0.25),
            inset 0 1px 0 rgb(255 255 255 / 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .t2-avatar {
        border: 3px solid #fff;
        box-shadow: 0 4px 12px rgb(0 0 0 / 0.15);
    }

    /* Clamp to 4 lines until expanded */
    .t2-quote {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 4;
        line-clamp: 4;
        overflow: hidden;
    }
    .t2-quote[data-expanded="true"] {
        -webkit-line-clamp: unset;
        line-clamp: unset;
        overflow: visible;
    }

    .t2-nav {
        display: inline-flex;
        height: 2.5rem;
        width: 2.5rem;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        background: #fff;
        color: #f97316;
        border: 1px solid rgb(251 146 60 / 0.4);
        box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);
        transition: background-color 0.2s, color 0.2s;
    }
    .t2-nav:hover {
        background: #f97316;
        color: #fff;
    }
    .t2-nav:focus-visible {
        outline: 2px solid #f97316;
        outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
        .t2-track {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    function init(root: HTMLElement) {
        const track = root.querySelector<HTMLElement>("[data-track]");
        if (!track) return;

        // Carousel arrows: scroll by one card width + gap
        const step = () => {
            const first = track.querySelector<HTMLElement>("li");
            return first ? first.offsetWidth + 24 : 320;
        };
        root.querySelector("[data-prev]")?.addEventListener("click", () =>
            track.scrollBy({ left: -step() }),
        );
        root.querySelector("[data-next]")?.addEventListener("click", () =>
            track.scrollBy({ left: step() }),
        );

        // Avatar fallback: hide broken images so the initials show
        root.querySelectorAll<HTMLImageElement>(".t2-avatar img").forEach((img) => {
            img.addEventListener("error", () => img.remove());
        });

        // "See more": only show the toggle when the quote is actually clamped
        const cards = root.querySelectorAll<HTMLElement>("article");
        const check = () => {
            cards.forEach((card) => {
                const quote = card.querySelector<HTMLElement>("[data-quote]");
                const btn = card.querySelector<HTMLButtonElement>("[data-toggle]");
                if (!quote || !btn) return;
                if (quote.dataset.expanded === "true") return; // keep toggle while open
                btn.hidden = quote.scrollHeight <= quote.clientHeight + 1;
            });
        };

        cards.forEach((card) => {
            const quote = card.querySelector<HTMLElement>("[data-quote]");
            const btn = card.querySelector<HTMLButtonElement>("[data-toggle]");
            btn?.addEventListener("click", () => {
                if (!quote) return;
                const open = quote.dataset.expanded !== "true";
                quote.dataset.expanded = String(open);
                btn.setAttribute("aria-expanded", String(open));
                btn.textContent = open ? "See less" : "See more";
            });
        });

        check();
        window.addEventListener("resize", check);
        document.fonts?.ready.then(check);
    }

    document.querySelectorAll<HTMLElement>("[data-testimonial-v2]").forEach(init);
</script>