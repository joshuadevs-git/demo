---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";

/*
  VIDEO FILES
  Astro serves everything inside the `public/` folder from the site root, so the file
  public/assets/videos/mission.mp4  is used as  "/assets/videos/mission.mp4"  (no "public" in the path).

  Every agent uses the same sample video for now. To give each agent their own video,
  change that agent's `mp4` (e.g. "/assets/videos/jules.mp4") or set `youtubeId` instead.
  The `image` photos are placeholders. Replace them with real thumbnails or photos.

  CAROUSEL
  Desktop shows 4 cards, tablet 2, phone 1. The arrows, dots, swipe and the left/right
  keys move it one card at a time and it loops, so there is no scrolling.

  SEE MORE
  Descriptions longer than 3 lines are cut off and get a "See more" button automatically.
  Short descriptions show nothing extra.
*/
const SAMPLE_VIDEO = "/assets/videos/proj.mp4";
const SEE_MORE = "See more";
const SEE_LESS = "See less";

const agents = [
  {
    name: "Coach Jules",
    role: "Medical Records Coordinator for law firms",
    headline: "Your experience is your advantage",
    description:
      "A former BPO Team Lead from Bacolod, now coordinating and retrieving medical records for law firms. Communication, organization and attention to detail carried straight over. Leading a team taught her how to stay calm under pressure, follow strict processes and communicate clearly with clients, and those habits are exactly what law firms value when every record and deadline matters.",
    image: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=1200&auto=format&fit=crop",
    youtubeId: "",
    mp4: SAMPLE_VIDEO,
  },
  {
    name: "Coach Cristina",
    role: "Paralegal Assistant, personal injury law firm",
    headline: "It's never too late to start again",
    description:
      "A Chemical Engineering graduate who moved through quality assurance, teaching and her own businesses before becoming a Paralegal Assistant. None of that experience was wasted.",
    image: "https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=1200&auto=format&fit=crop",
    youtubeId: "",
    mp4: SAMPLE_VIDEO,
  },
  {
    name: "Coach Christine",
    role: "Assistant to the Intake Director",
    headline: "Every experience has a purpose",
    description:
      "From Office Assistant to Human Resources to the legal industry. Her path wasn't a straight line, but every step prepared her for where she is today.",
    image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=1200&auto=format&fit=crop",
    youtubeId: "",
    mp4: SAMPLE_VIDEO,
  },
  {
    name: "Coach Fran",
    role: "Intake Coordinator, US-based law firm",
    headline: "You are more qualified than you think",
    description:
      "Nine years in BPO and an IT degree led to intake work for a US law firm. The skills law firms look for may already be yours. Handling hundreds of customer conversations taught her to listen closely, ask the right questions and document everything accurately, which is the core of good client intake. She now helps others see that the skills they built in their previous jobs can open doors in the legal industry.",
    image: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?q=80&w=1200&auto=format&fit=crop",
    youtubeId: "",
    mp4: SAMPLE_VIDEO,
  },
];
---

<Section id="video-testimonials" tone="page" class="py-16 md:py-24 bg-white overflow-hidden">
  <Container class="w-full max-w-[72rem] mx-auto px-[clamp(1.25rem,5vw,3rem)]">

    <!-- Header -->
    <div class="mb-10 md:mb-14 grid gap-5 md:grid-cols-[1fr_auto] md:items-end md:gap-16">
      <div>
        <p class="flex items-center gap-3 text-sm font-medium text-[#FF8A00]">
          <span class="h-px w-8 bg-[#FF8A00]"></span>
          Video testimonials
        </p>
        <h2 class="mt-4 max-w-3xl text-[clamp(2.1rem,4.2vw,3.5rem)] leading-[1.05] font-bold tracking-tight text-[#12213F]">
          Hear it from our agents
        </h2>
      </div>
      <p class="max-w-sm text-[#5A6478] text-base md:text-lg leading-relaxed">
        Real career journeys, in their own words.
      </p>
    </div>

    <!-- Carousel -->
    <div class="vt-carousel" data-vt-carousel>
      <div class="vt-viewport" data-vt-viewport>
        <ul class="vt-track" data-vt-track>
          {agents.map((agent) => (
            <li class="vt-card" data-vt-card>
              <div
                class="vt-media"
                data-name={agent.name}
                data-poster={agent.image}
                data-youtube={agent.youtubeId}
                data-mp4={agent.mp4}
              >
                <!-- Thumbnail + play button -->
                <button type="button" class="vt-thumb" aria-label={`Play ${agent.name}'s video story`}>
                  <img src={agent.image} alt="" loading="lazy" draggable="false" />
                  <span class="vt-shade" aria-hidden="true"></span>
                  <span class="vt-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="size-6">
                      <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14z" />
                    </svg>
                  </span>
                </button>

                <!-- The video appears here when played -->
                <div class="vt-slot"></div>
              </div>

              <div class="vt-body">
                <p class="vt-name">{agent.name}</p>
                <p class="vt-role">{agent.role}</p>

                <div class="vt-rule" aria-hidden="true"></div>

                <h3 class="vt-headline">{agent.headline}</h3>

                <div class="vt-text">
                  <p class="vt-desc" data-vt-desc>{agent.description}</p>
                  <button type="button" class="vt-more" data-vt-more aria-expanded="false" hidden>
                    {SEE_MORE}
                  </button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Carousel controls -->
      <div class="vt-controls">
        <button type="button" class="vt-arrow" data-vt-prev aria-label="Previous video">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg>
        </button>
        <div class="vt-dots" data-vt-dots role="group" aria-label="Choose video"></div>
        <button type="button" class="vt-arrow" data-vt-next aria-label="Next video">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </Container>
</Section>

<style>
  /* ---------- Carousel ---------- */
  .vt-carousel {
    position: relative;
  }

  /* Small side padding gives the shadows room. It is smaller than the gap,
     so the next card never peeks in at the edge. */
  .vt-viewport {
    overflow: hidden;
    padding: 1.5rem 1rem 2rem;
    margin: -1.5rem -1rem 0;
    touch-action: pan-y;
  }

  .vt-track {
    --vt-view: 1;
    --vt-gap: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: var(--vt-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 600ms cubic-bezier(0.22, 0.8, 0.24, 1);
    will-change: transform;
  }
  @media (min-width: 640px) {
    .vt-track {
      --vt-view: 2;
      --vt-gap: 1.5rem;
    }
  }
  @media (min-width: 1100px) {
    .vt-track {
      --vt-view: 4;
      --vt-gap: 1.75rem;
    }
  }

  .vt-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .vt-arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid #e4e8f0;
    border-radius: 999px;
    background: #fff;
    color: #12213f;
    box-shadow: 0 1px 2px rgba(18, 33, 63, 0.06), 0 10px 24px -8px rgba(18, 33, 63, 0.22);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 200ms ease;
  }
  .vt-arrow:hover {
    background: #12213f;
    border-color: #12213f;
    color: #fff;
    transform: translateY(-2px);
  }
  .vt-arrow:focus-visible,
  .vt-dot:focus-visible {
    outline: 3px solid #ff8a00;
    outline-offset: 3px;
  }

  .vt-dots {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .vt-dot {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #cfd6e4;
    cursor: pointer;
    transition: width 300ms ease, background-color 300ms ease;
  }
  .vt-dot[aria-current="true"] {
    width: 2rem;
    background: #ff8a00;
  }

  /* ---------- Card ---------- */
  .vt-card {
    flex: 0 0 calc((100% - (var(--vt-view) - 1) * var(--vt-gap)) / var(--vt-view));
    min-width: 0;
  }

  .vt-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #0b1220;
    box-shadow:
      0 2px 4px rgba(18, 33, 63, 0.06),
      0 18px 36px -16px rgba(18, 33, 63, 0.28);
  }

  /* Thumbnail */
  .vt-thumb {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    background: #e6eaf2;
  }
  .vt-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
    transition: transform 900ms cubic-bezier(0.22, 0.8, 0.24, 1);
  }
  .vt-card:hover .vt-thumb img {
    transform: scale(1.03);
  }
  .vt-thumb:focus-visible {
    outline: 3px solid #ff8a00;
    outline-offset: -3px;
  }
  .vt-media.is-playing .vt-thumb {
    display: none;
  }

  .vt-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 18, 32, 0) 55%, rgba(11, 18, 32, 0.3) 100%);
  }

  /* Play button */
  .vt-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding-left: 0.15rem; /* optically centers the triangle */
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.95);
    color: #12213f;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    transform: translate(-50%, -50%);
    transition: transform 300ms ease, background-color 300ms ease;
  }
  .vt-card:hover .vt-play,
  .vt-thumb:focus-visible .vt-play {
    background: #ff8a00;
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* Video area (filled by the script) */
  .vt-slot {
    position: absolute;
    inset: 0;
    display: none;
    background: #0b1220;
  }
  .vt-media.is-playing .vt-slot {
    display: block;
  }
  .vt-slot :global(video),
  .vt-slot :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    background: #0b1220;
  }
  .vt-slot :global(.vt-stop) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: rgba(11, 18, 32, 0.7);
    color: #fff;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .vt-slot :global(.vt-stop:hover) {
    background: #fff;
    color: #12213f;
  }
  .vt-slot :global(.vt-stop:focus-visible) {
    outline: 2px solid #ff8a00;
    outline-offset: 2px;
  }
  .vt-slot :global(.vt-empty) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* ---------- Text ---------- */
  .vt-body {
    padding-top: 1.1rem;
  }

  .vt-name {
    color: #12213f;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .vt-role {
    margin-top: 0.25rem;
    color: #5a6478;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .vt-rule {
    height: 1px;
    margin: 1rem 0;
    background: #e4e8f0;
  }

  .vt-headline {
    color: #12213f;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .vt-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    margin-top: 0.5rem;
  }

  .vt-desc {
    color: #5a6478;
    font-size: 0.88rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .vt-desc.is-open {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .vt-more {
    padding: 0;
    border: 0;
    background: none;
    color: #12213f;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #ff8a00;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .vt-more[hidden] {
    display: none;
  }
  .vt-more:hover {
    color: #ff8a00;
  }
  .vt-more:focus-visible {
    outline: 2px solid #ff8a00;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-thumb img,
    .vt-play,
    .vt-track,
    .vt-arrow,
    .vt-dot {
      transition: none;
    }
    .vt-arrow:hover { transform: none; }
    .vt-card:hover .vt-thumb img { transform: none; }
  }
</style>

<script>
  const SEE_MORE = "See more";
  const SEE_LESS = "See less";

  const root = document.querySelector<HTMLElement>("#video-testimonials");
  const carousel = root?.querySelector<HTMLElement>("[data-vt-carousel]");

  if (root && carousel) {
    const viewport = carousel.querySelector<HTMLElement>("[data-vt-viewport]")!;
    const track = carousel.querySelector<HTMLElement>("[data-vt-track]")!;
    const prevButton = carousel.querySelector<HTMLButtonElement>("[data-vt-prev]");
    const nextButton = carousel.querySelector<HTMLButtonElement>("[data-vt-next]");
    const dotsWrap = carousel.querySelector<HTMLElement>("[data-vt-dots]");

    /* ---------- Looping: a second copy of the cards follows the first ---------- */
    const originals = Array.from(track.children) as HTMLElement[];
    const total = originals.length;
    originals.forEach((card, i) => (card.dataset.orig = String(i)));
    originals.forEach((card) => track.appendChild(card.cloneNode(true)));

    /* ---------- Video ---------- */
    let current: HTMLElement | null = null;

    const stop = (card: HTMLElement) => {
      const slot = card.querySelector<HTMLElement>(".vt-slot");
      slot?.querySelectorAll("video").forEach((v) => v.pause());
      if (slot) slot.innerHTML = "";
      card.classList.remove("is-playing");
      if (current === card) current = null;
    };

    const showMessage = (slot: HTMLElement, text: string) => {
      slot.querySelectorAll("video, iframe, .vt-empty").forEach((el) => el.remove());
      const msg = document.createElement("div");
      msg.className = "vt-empty";
      msg.textContent = text;
      slot.appendChild(msg);
    };

    const play = (card: HTMLElement) => {
      // Only one video plays at a time
      if (current && current !== card) stop(current);

      const slot = card.querySelector<HTMLElement>(".vt-slot");
      if (!slot) return;
      const { name = "Agent", poster = "", youtube = "", mp4 = "" } = card.dataset;

      slot.innerHTML = "";
      let media: HTMLElement | null = null;

      if (youtube) {
        const frame = document.createElement("iframe");
        frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtube)}?autoplay=1&rel=0&playsinline=1`;
        frame.title = `${name} video testimonial`;
        frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        frame.allowFullscreen = true;
        media = frame;
      } else if (mp4) {
        const video = document.createElement("video");
        video.src = mp4;
        video.poster = poster;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = "auto";
        video.addEventListener("ended", () => stop(card));
        // Shows a clear message if the file path is wrong or the file can't be read
        video.addEventListener("error", () =>
          showMessage(slot, `We couldn't load this video. Check that the file exists at ${mp4}`)
        );
        media = video;
      }

      if (media) {
        slot.appendChild(media);
      } else {
        showMessage(slot, "Video coming soon.");
      }

      // Close button: goes back to the thumbnail
      const close = document.createElement("button");
      close.type = "button";
      close.className = "vt-stop";
      close.setAttribute("aria-label", "Close video");
      close.innerHTML =
        '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/></svg>';
      close.addEventListener("click", () => {
        stop(card);
        card.querySelector<HTMLElement>(".vt-thumb")?.focus();
      });
      slot.appendChild(close);

      card.classList.add("is-playing");
      current = card;

      if (media instanceof HTMLVideoElement) {
        media.play().catch(() => {
          /* if the browser blocks autoplay, the controls are visible so the viewer can press play */
        });
      }
    };

    track.querySelectorAll<HTMLElement>(".vt-media").forEach((card) => {
      card.querySelector<HTMLElement>(".vt-thumb")?.addEventListener("click", () => play(card));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && current) stop(current);
    });

    /* ---------- See more / See less ---------- */
    const descs = Array.from(track.querySelectorAll<HTMLElement>("[data-vt-desc]"));

    // Show the button only when the text is actually cut off
    const measure = () => {
      descs.forEach((desc) => {
        const button = desc.parentElement?.querySelector<HTMLButtonElement>("[data-vt-more]");
        if (!button) return;
        const open = desc.classList.contains("is-open");
        button.hidden = !(open || desc.scrollHeight > desc.clientHeight + 1);
      });
    };

    track.querySelectorAll<HTMLButtonElement>("[data-vt-more]").forEach((button) => {
      button.addEventListener("click", () => {
        const desc = button.parentElement?.querySelector<HTMLElement>("[data-vt-desc]");
        if (!desc) return;
        const open = desc.classList.toggle("is-open");
        button.textContent = open ? SEE_LESS : SEE_MORE;
        button.setAttribute("aria-expanded", String(open));
      });
    });

    document.fonts?.ready.then(measure);
    measure();

    /* ---------- Carousel ---------- */
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const wideMq = window.matchMedia("(min-width: 1100px)");
    const mediumMq = window.matchMedia("(min-width: 640px)");
    // Must match the CSS breakpoints on .vt-track
    const perView = () => (wideMq.matches ? 4 : mediumMq.matches ? 2 : 1);

    let dots: HTMLButtonElement[] = [];
    let busy = false;

    const cardsNow = () => Array.from(track.children) as HTMLElement[];
    const firstOrig = () => Number((track.firstElementChild as HTMLElement).dataset.orig);
    const stepPx = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (track.firstElementChild as HTMLElement).offsetWidth + gap;
    };

    const setX = (px: number, animate: boolean) => {
      track.style.transition = animate ? "" : "none";
      track.style.transform = `translate3d(${px}px, 0, 0)`;
    };

    // Cards outside the view can't be tabbed to or read by screen readers
    const sync = () => {
      const view = perView();
      cardsNow().forEach((card, i) => {
        const visible = i < view;
        card.toggleAttribute("inert", !visible);
        card.setAttribute("aria-hidden", visible ? "false" : "true");
      });
      const first = firstOrig();
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === first)));
    };

    const afterSlide = (done: () => void) => {
      if (reduceMotion.matches) {
        done();
        return;
      }
      let finished = false;
      const run = () => {
        if (finished) return;
        finished = true;
        track.removeEventListener("transitionend", onEnd);
        done();
      };
      const onEnd = (e: TransitionEvent) => {
        if (e.target === track && e.propertyName === "transform") run();
      };
      track.addEventListener("transitionend", onEnd);
      setTimeout(run, 800); // safety net
    };

    // n > 0 slides forward by n cards, n < 0 slides back
    const move = (n: number) => {
      if (busy || n === 0) return;
      if (current) stop(current); // pause any playing video before sliding
      busy = true;
      const step = stepPx();

      if (n > 0) {
        void track.offsetWidth;
        setX(-n * step, true);
        afterSlide(() => {
          for (let k = 0; k < n; k++) track.appendChild(track.firstElementChild as HTMLElement);
          setX(0, false);
          sync();
          busy = false;
        });
      } else {
        const m = -n;
        for (let k = 0; k < m; k++) track.insertBefore(track.lastElementChild as HTMLElement, track.firstElementChild);
        setX(-m * step, false);
        void track.offsetWidth;
        setX(0, true);
        afterSlide(() => {
          sync();
          busy = false;
        });
      }
    };

    const goToOriginal = (target: number) => {
      const forward = (target - firstOrig() + total) % total;
      if (forward === 0) return;
      move(forward <= total / 2 ? forward : -(total - forward));
    };

    const buildDots = () => {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = "";
      dots = [];
      for (let i = 0; i < total; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "vt-dot";
        dot.setAttribute("aria-label", `Go to video ${i + 1}`);
        dot.addEventListener("click", () => goToOriginal(i));
        dotsWrap.appendChild(dot);
        dots.push(dot);
      }
    };

    prevButton?.addEventListener("click", () => move(-1));
    nextButton?.addEventListener("click", () => move(1));

    // Arrow keys (ignored while interacting with a video)
    carousel.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("video, iframe")) return;
      if (e.key === "ArrowLeft") move(-1);
      if (e.key === "ArrowRight") move(1);
    });

    // Swipe on touch screens and with a mouse drag
    let startX = 0;
    let tracking = false;
    let swiped = false;

    viewport.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement).closest(".vt-slot")) return; // don't hijack video controls
      tracking = true;
      swiped = false;
      startX = e.clientX;
    });
    viewport.addEventListener("pointerup", (e) => {
      if (!tracking) return;
      tracking = false;
      const diff = e.clientX - startX;
      if (Math.abs(diff) < 50) return;
      swiped = true;
      move(diff < 0 ? 1 : -1);
      setTimeout(() => (swiped = false), 0);
    });
    viewport.addEventListener("pointercancel", () => (tracking = false));
    // A swipe that starts on a thumbnail must not also start the video
    viewport.addEventListener(
      "click",
      (e) => {
        if (swiped) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true
    );

    window.addEventListener("resize", () => {
      setX(0, false);
      sync();
      measure();
    });

    buildDots();
    setX(0, false);
    sync();
  }
</script>