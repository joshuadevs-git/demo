
---
import { getNovaCopy, type NovaLocale } from '@utils/nova-i18n';

interface Props {
  locale?: NovaLocale;
}

const { locale = 'en' } = Astro.props as Props;
const copy = getNovaCopy(locale).navigation;
---

<div class="nova-language-switch" aria-label={copy.languageLabel}>
  <span class="nova-language-switch__link is-active" aria-current="page">EN</span>
</div>

<style>
  .nova-language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .nova-language-switch__link {
    border-radius: 0.25rem;
    padding: 0.35rem 0.2rem;
    color: var(--color-brand-accent);
    opacity: 1;
    text-decoration: none;
  }
</style>
