<div
  id="casebridge-preloader"
  role="progressbar"
  aria-label="Loading website"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  transition:persist="casebridge-preloader"
>
  <div class="cb-content">
    <div class="cb-stage">
      <!-- Progress ring -->
      <svg class="cb-ring" viewBox="0 0 320 320" aria-hidden="true">
        <circle class="cb-ring-bg" cx="160" cy="160" r="148" />
        <circle class="cb-ring-fill" cx="160" cy="160" r="148" />
      </svg>

      <!-- Uiverse loader (class names prefixed with cb- to avoid collisions) -->
      <div class="cb-loader" aria-hidden="true">
        <div class="cb-loader-circle cb-loader-c1"></div>
        <div class="cb-loader-circle cb-loader-c2"></div>
        <div class="cb-loader-circle cb-loader-c3"></div>
        <div class="cb-loader-circle cb-loader-c4"></div>
        <span class="cb-loader-text">Loading...</span>
      </div>
    </div>

    <p class="cb-tagline">Building a stronger future together.</p>

    <div class="cb-info" aria-hidden="true">
      <span class="cb-status">Initializing</span>
      <span class="cb-percent"><span class="cb-num">0</span>%</span>
    </div>
  </div>

  <div class="cb-footer" aria-hidden="true">
    <span>CASEBRIDGE</span>
    <span>EST. IN EXCELLENCE</span>
  </div>
</div>

<noscript>
  <style is:inline>
    #casebridge-preloader {
      display: none !important;
    }
    html.cb-loading {
      overflow: auto !important;
    }
  </style>
</noscript>

<style is:global>
  html.cb-loading {
    overflow: hidden;
  }

  #casebridge-preloader {
    --cb-navy: #17233d;
    --cb-muted: #8a93a3;
    --cb-orange: #e58a32;

    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #ffffff;
    color: var(--cb-navy);
    font-family: inherit;
    transform: translateY(0);
    transition: transform 900ms cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
  }

  #casebridge-preloader.is-leaving {
    transform: translateY(-100%);
  }

  #casebridge-preloader.is-leaving .cb-content,
  #casebridge-preloader.is-leaving .cb-footer {
    opacity: 0;
    transform: scale(0.96);
  }

  #casebridge-preloader.is-done,
  #casebridge-preloader.is-skipped {
    display: none !important;
  }

  #casebridge-preloader .cb-content,
  #casebridge-preloader .cb-footer {
    transition:
      opacity 400ms ease,
      transform 600ms ease;
  }

  #casebridge-preloader .cb-content {
    width: min(340px, calc(100% - 48px));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: cb-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ---------- Stage ---------- */
  #casebridge-preloader .cb-stage {
    position: relative;
    width: min(300px, 78vw);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  /* ---------- Progress ring ---------- */
  #casebridge-preloader .cb-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    overflow: visible;
  }

  #casebridge-preloader .cb-ring circle {
    fill: none;
    stroke-width: 6;
  }

  #casebridge-preloader .cb-ring-bg {
    stroke: rgba(23, 35, 61, 0.08);
  }

  #casebridge-preloader .cb-ring-fill {
    stroke: var(--cb-orange);
    stroke-linecap: round;
    stroke-dasharray: 930;
    stroke-dashoffset: 930;
    filter: drop-shadow(0 0 5px rgba(229, 138, 50, 0.5));
  }

  /*
    From Uiverse.io by moasko - https://uiverse.io/moasko/rude-catfish-31
    MIT License, Copyright (c) moasko (moasko.dev)
  */
  #casebridge-preloader .cb-loader {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #casebridge-preloader .cb-loader-circle {
    width: 200px;
    height: 200px;
    border-radius: 360px 400px;
    border: 12px solid;
    position: absolute;
  }

  #casebridge-preloader .cb-loader-c1 {
    animation: cb-loader-rota 2.2s linear infinite;
    border-color: orange;
  }

  #casebridge-preloader .cb-loader-c2 {
    animation: cb-loader-rota 3s linear infinite;
    border-color: red;
  }

  #casebridge-preloader .cb-loader-c3 {
    animation: cb-loader-rota 2s linear infinite;
    border-color: #fff;
    opacity: 0.5;
  }

  #casebridge-preloader .cb-loader-c4 {
    animation: cb-loader-rota 1s linear infinite;
    border-color: white;
    opacity: 0.8;
  }

  @keyframes cb-loader-rota {
    100% {
      transform: rotate(360deg);
    }
  }

  /* Centered "Loading..." text */
  #casebridge-preloader .cb-loader-text {
    position: relative;
    z-index: 1;
    color: var(--cb-navy);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.12em;
    user-select: none;
  }

  /* ---------- Text ---------- */
  #casebridge-preloader .cb-tagline {
    margin: 30px 0 0;
    color: var(--cb-muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #casebridge-preloader .cb-info {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 14px;
    margin-top: 16px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #casebridge-preloader .cb-status {
    color: var(--cb-muted);
  }

  #casebridge-preloader .cb-percent {
    min-width: 4ch;
    text-align: left;
    color: var(--cb-navy);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }

  #casebridge-preloader .cb-footer {
    position: absolute;
    right: 32px;
    bottom: 28px;
    left: 32px;
    display: flex;
    justify-content: space-between;
    color: #aab0bb;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  /* ---------- Animations ---------- */
  @keyframes cb-enter {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #casebridge-preloader {
      transform: none !important;
      transition: opacity 200ms ease;
    }
    #casebridge-preloader.is-leaving {
      opacity: 0;
    }
    #casebridge-preloader .cb-content {
      animation: none;
    }
  }
</style>

<!--
  Inline (non-bundled) script: runs synchronously right after the markup is
  parsed, so a returning visitor never sees a flash of the preloader.
-->
<script is:inline>
  (function () {
    var root = document.documentElement;
    var preloader = document.getElementById('casebridge-preloader');

    if (!preloader || preloader.dataset.initialized === 'true') return;
    preloader.dataset.initialized = 'true';

    var KEY = 'casebridge-preloader-shown';

    // Show once per browser tab session.
    try {
      if (sessionStorage.getItem(KEY) === 'true') {
        preloader.classList.add('is-skipped');
        return;
      }
      sessionStorage.setItem(KEY, 'true');
    } catch (e) {}

    root.classList.add('cb-loading');

    var ring = preloader.querySelector('.cb-ring-fill');
    var num = preloader.querySelector('.cb-num');
    var statusText = preloader.querySelector('.cb-status');
    var CIRC = 2 * Math.PI * 148; // matches the SVG circle radius

    ring.style.strokeDasharray = String(CIRC);
    ring.style.strokeDashoffset = String(CIRC);

    var MIN_DURATION = 900; // avoids a distracting flash on fast loads
    var MAX_WAIT = 30000; // last-resort only; normally the site opens ONLY after loading reaches 100%
    var HOLD = 350; // pause at 100% before revealing

    var stages = [
      [0, 'Initializing'],
      [30, 'Loading resources'],
      [60, 'Preparing experience'],
      [85, 'Almost ready'],
      [100, 'Complete']
    ];

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var start = performance.now();
    var shown = 0; // displayed value (always monotonic)
    var last = start;
    var finished = false;
    var fontsReady = !(document.fonts && document.fonts.ready);
    var windowLoaded = document.readyState === 'complete';
    var lastLabel = '';
    var lastAria = -1;

    if (!fontsReady) {
      document.fonts.ready.then(
        function () { fontsReady = true; },
        function () { fontsReady = true; }
      );
    }
    if (!windowLoaded) {
      window.addEventListener('load', function () { windowLoaded = true; }, { once: true });
    }

    /**
     * Real progress, 0-100, from what the browser has actually loaded:
     *   document parsing ........ up to 35
     *   stylesheets ............. up to 15
     *   web fonts ............... up to 10
     *   eager images ............ up to 30
     *   window "load" event ..... final 10
     */
    function measure() {
      if (windowLoaded) return 100;

      var score = 0;
      var rs = document.readyState;

      score += rs === 'loading' ? 10 : 35;

      var links = document.querySelectorAll('link[rel="stylesheet"]');
      if (links.length) {
        var cssDone = 0;
        for (var i = 0; i < links.length; i++) {
          try { if (links[i].sheet) cssDone++; } catch (e) { cssDone++; }
        }
        score += 15 * (cssDone / links.length);
      } else {
        score += rs === 'loading' ? 0 : 15;
      }

      score += fontsReady ? 10 : 0;

      // Images that load immediately (lazy ones are excluded on purpose)
      var imgs = document.querySelectorAll('img:not([loading="lazy"])');
      var total = 0;
      var done = 0;
      for (var j = 0; j < imgs.length; j++) {
        var img = imgs[j];
        if (!img.currentSrc && !img.getAttribute('src')) continue;
        total++;
        if (img.complete) done++;
      }
      if (total) {
        score += 30 * (done / total);
      } else {
        score += rs === 'loading' ? 0 : 30;
      }

      return Math.min(score, 99);
    }

    function render(value) {
      var v = Math.min(100, Math.max(0, value));
      var rounded = Math.round(v);

      ring.style.strokeDashoffset = String(CIRC * (1 - v / 100));
      if (num) num.textContent = String(rounded);

      if (statusText) {
        var label = stages[0][1];
        for (var i = 0; i < stages.length; i++) {
          if (rounded >= stages[i][0]) label = stages[i][1];
        }
        if (label !== lastLabel) {
          statusText.textContent = label;
          lastLabel = label;
        }
      }

      // Update assistive tech in coarse steps, not every frame.
      var step = Math.floor(rounded / 10) * 10;
      if (step !== lastAria) {
        preloader.setAttribute('aria-valuenow', String(rounded));
        lastAria = step;
      }
    }

    function reveal() {
      root.classList.remove('cb-loading');
      preloader.classList.add('is-leaving');

      var cleanup = function () {
        preloader.classList.add('is-done');
      };

      preloader.addEventListener('transitionend', function handler(e) {
        if (e.target !== preloader) return;
        preloader.removeEventListener('transitionend', handler);
        cleanup();
      });
      // Fallback in case transitionend never fires.
      window.setTimeout(cleanup, reduceMotion ? 400 : 1200);
    }

    function finish() {
      if (finished) return;
      finished = true;
      render(100);
      window.setTimeout(reveal, reduceMotion ? 0 : HOLD);
    }

    function tick(now) {
      if (finished) return;

      var elapsed = now - start;
      var dt = Math.min(now - last, 50);
      last = now;

      var real = measure();
      // Time ceiling keeps the animation smooth on fast loads,
      // but the bar never shows more than what has really loaded.
      var timeCap = Math.min(100, (elapsed / MIN_DURATION) * 100);
      var target = Math.min(real, timeCap);

      // Ease toward the target; never go backwards.
      var ease = 1 - Math.exp(-dt / 140);
      var next = shown + (target - shown) * ease;
      if (target - next < 0.15) next = target;
      shown = Math.max(shown, next);

      render(shown);

      if (shown >= 100 && windowLoaded && fontsReady) {
        finish();
        return;
      }

      // Last-resort fallback for a stalled connection (30s+).
      if (elapsed >= MAX_WAIT) {
        finish();
        return;
      }

      requestAnimationFrame(tick);
    }

    // Back/forward cache restore: skip straight past the preloader.
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) {
        finished = true;
        root.classList.remove('cb-loading');
        preloader.classList.add('is-done');
      }
    });

    render(0);
    requestAnimationFrame(tick);
  })();
</script>